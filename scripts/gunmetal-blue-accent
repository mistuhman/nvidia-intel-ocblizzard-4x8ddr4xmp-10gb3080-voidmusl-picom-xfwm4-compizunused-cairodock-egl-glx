#!/usr/bin/env python3
"""gunmetal-blue-accent — recolour ONLY the red accents of the installed
Quake-Gunmetal themes to Prussian blue. Nothing else changes: selections
keep their black gradient, no white is introduced, every modified tree is
backed up first and fully restorable.

Scans the real theme directories for red (no assumed filenames beyond the
gunmetal theme layout): emerald close-button pixmaps, the GTK selected-plate
red edge, and #640c12 accent hexes in gunmetal-3d.css.

  gunmetal-blue-accent apply    # backup + red -> Prussian blue
  gunmetal-blue-accent restore  # newest backup per tree swapped back
  gunmetal-blue-accent status
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
from pathlib import Path
import re
import shutil
import sys
import time

BACKUP_TAG = ".pre-blue-accent."


def load_sibling(name: str):
    path = Path(__file__).resolve().parent / name
    if not path.is_file():
        raise SystemExit(f"ERROR: required sibling tool missing: {path}")
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


base = load_sibling("gunmetal-emerald-theme")

# Prussian ramp mirroring the gunmetal red ramp's shade range (28..238 in R).
RED_FLOOR, RED_CEIL = 28.0, 238.0


def blue_of(r: int, g: int, b: int) -> tuple[int, int, int]:
    t = min(1.0, max(0.0, (r - RED_FLOOR) / (RED_CEIL - RED_FLOOR)))
    return (round(4 + t * 58), round(18 + t * 72), round(44 + t * 118))


def is_red(r: int, g: int, b: int) -> bool:
    return r > g + 25 and r > b + 25 and r >= 60


def recolor_png(path: Path) -> int:
    width, height, pixels = base.read_png(path)
    changed = 0
    result = []
    for r, g, b, a in pixels:
        if a > 0 and is_red(r, g, b):
            nr, ng, nb = blue_of(r, g, b)
            changed += 1
        else:
            nr, ng, nb = r, g, b
        result.append((nr, ng, nb, a))
    if changed:
        base.write_png(path, width, height, result)
    return changed


def scan_trees(home: Path) -> list[Path]:
    trees = []
    for root in (home / ".emerald" / "themes", home / ".themes"):
        if not root.is_dir():
            continue
        for tree in sorted(root.iterdir()):
            # Backups (.pre-*) hold the original red on purpose: never touch.
            if tree.is_dir() and not tree.name.startswith((".pre-", ".")):
                trees.append(tree)
    active = home / ".emerald" / "theme"
    if active.is_dir() and active not in trees:
        trees.append(active)
    return trees


def css_accent_hexes(text: str) -> set[str]:
    return {
        m.group(0).lower()
        for m in re.finditer(r"#[0-9a-fA-F]{6}\b", text)
        if is_red(int(m.group(0)[1:3], 16), int(m.group(0)[3:5], 16), int(m.group(0)[5:7], 16))
    }


def css_replacement(sample_red: tuple[int, int, int]) -> str:
    r, g, b = blue_of(*sample_red)
    return f"#{r:02x}{g:02x}{b:02x}"


def plan_tree(tree: Path) -> dict:
    """Examine one theme tree: what red accents exist (context, no assumptions)."""
    findings = {"tree": tree, "png_targets": [], "css_targets": []}
    for path in sorted(tree.rglob("*.png")):
        if "close" not in path.name and "selected" not in path.name:
            continue
        try:
            _, _, pixels = base.read_png(path)
        except SystemExit:
            continue
        if any(a > 0 and is_red(r, g, b) for r, g, b, a in pixels):
            findings["png_targets"].append(path)
    for path in sorted(tree.rglob("*.css")):
        try:
            text = path.read_text()
        except OSError:
            continue
        reds = css_accent_hexes(text)
        if reds:
            findings["css_targets"].append((path, sorted(reds)))
    return findings


def backup_tree(tree: Path) -> Path | None:
    stamp = int(time.time())
    backup = tree.with_name(f"{tree.name}{BACKUP_TAG}{stamp}")
    while backup.exists():
        stamp += 1
        backup = tree.with_name(f"{tree.name}{BACKUP_TAG}{stamp}")
    shutil.copytree(tree, backup, symlinks=True)
    return backup


def apply(home: Path) -> None:
    any_change = False
    for findings in (plan_tree(t) for t in scan_trees(home)):
        tree = findings["tree"]
        pngs = findings["png_targets"]
        css_files = [p for p, _ in findings["css_targets"]]
        if not pngs and not css_files:
            continue
        backup = backup_tree(tree)
        print(f"Tree: {tree}")
        print(f"  Backup: {backup}")
        for path in pngs:
            changed = recolor_png(path)
            print(f"  PNG red->blue: {path.relative_to(tree)} ({changed} px)")
            any_change = any_change or changed > 0
        for path, reds in findings["css_targets"]:
            text = path.read_text()
            for red in reds:
                sample = (
                    int(red[1:3], 16),
                    int(red[3:5], 16),
                    int(red[5:7], 16),
                )
                blue = css_replacement(sample)
                count = text.lower().count(red)
                text = re.sub(red, blue, text, flags=re.IGNORECASE)
                print(f"  CSS {red} -> {blue}: {path.relative_to(tree)} ({count}x)")
                any_change = any_change or count > 0
            path.write_text(text)
    if not any_change:
        print("No red accents found; nothing changed.")
    print("Emerald needs a restart to show new pixmaps: emerald --replace")


def newest_backup(tree: Path) -> Path | None:
    backups = sorted(
        (p for p in tree.parent.glob(tree.name + BACKUP_TAG + "*") if p.is_dir()),
        key=lambda p: p.name,
    )
    return backups[-1] if backups else None


def restore(home: Path) -> None:
    restored = False
    for tree in scan_trees(home):
        backup = newest_backup(tree)
        if not backup:
            continue
        shutil.rmtree(tree)
        backup.rename(tree)
        print(f"Restored {tree} from {backup}")
        restored = True
    if not restored:
        print("No blue-accent backups found; nothing restored.")


def status(home: Path) -> None:
    for findings in (plan_tree(t) for t in scan_trees(home)):
        tree = findings["tree"]
        label = "RED accents present (apply pending)" if (
            findings["png_targets"] or findings["css_targets"]
        ) else "no red accents (applied, or not a gunmetal theme)"
        print(f"{tree}: {label}")
        for path in findings["png_targets"]:
            print(f"  png: {path.relative_to(tree)}")
        for path, reds in findings["css_targets"]:
            print(f"  css: {path.relative_to(tree)} reds={','.join(reds)}")
        backup = newest_backup(tree)
        if backup:
            print(f"  rollback backup: {backup}")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("apply", help="backup then recolour red accents to Prussian blue")
    sub.add_parser("restore", help="restore the newest backup per modified tree")
    sub.add_parser("status", help="show red/blue state and backups")
    args = parser.parse_args()
    home = Path.home()
    if args.command == "apply":
        apply(home)
    elif args.command == "restore":
        restore(home)
    else:
        status(home)


if __name__ == "__main__":
    main()
