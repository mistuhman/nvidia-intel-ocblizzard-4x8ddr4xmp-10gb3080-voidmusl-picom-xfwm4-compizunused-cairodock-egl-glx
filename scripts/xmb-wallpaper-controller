#!/usr/bin/env python3
import collections, fcntl, json, math, os, re, select, shlex, shutil, signal, socket, subprocess, sys, time
from pathlib import Path
ROOT = Path(os.getenv("XMB_BAKE_ROOT", "/mnt/games/xmb-wave-bake"))
CFG = Path(os.getenv("XMB_CONFIG", Path.home() / ".config/xmb-wallpaper.conf"))
RUN = Path(os.getenv("XDG_RUNTIME_DIR", "/tmp")) / f"xmb-wallpaper-{os.getuid()}"
PID, STATE, SOCK = (RUN / name for name in ("controller.pid", "state.json", "mpv.sock"))
LOG = Path(os.getenv("XMB_CONTROLLER_LOG", "/tmp/xmb-wallpaper-controller.log"))
SHIM = Path(os.getenv("XMB_SHIM", Path.home() / ".local/bin/mpv-xwinwrap-shim"))
SHADER = Path(os.getenv("XMB_BLUR_SHADER", Path.home() / ".local/bin/xmb-transition-blur.glsl"))
ROLES = ("main-red", "work-monochrome", "sleep"); stop_now = False
def fail(text): print(f"xmb-controller: {text}", file=sys.stderr); raise SystemExit(2)
def video(role): return ROOT / "out" / role / f"{role}.loop-60s.mp4"
def config():
    out = {"roles": ["main-red", "work-monochrome", "work-monochrome", "main-red"], "fade": 350, "blur": 500, "hwdec": "nvdec-copy", "peak": 6.0, "pause_fullscreen": True}
    if CFG.is_file():
        for raw in CFG.read_text().splitlines():
            line = raw.split("#", 1)[0].strip()
            if not line: continue
            match = re.fullmatch(r"ROLES=\((.*)\)", line)
            if match: out["roles"] = shlex.split(match.group(1))
            elif line.startswith("FADE_MS="): out["fade"] = int(line.split("=", 1)[1])
            elif line.startswith("BLUR_MS="): out["blur"] = int(line.split("=", 1)[1])
            elif line.startswith("HWDEC="): out["hwdec"] = line.split("=", 1)[1].strip()
            elif line.startswith("BLUR_PEAK="): out["peak"] = float(line.split("=", 1)[1])
            elif line.startswith("PAUSE_FULLSCREEN="):
                value = line.split("=", 1)[1].strip().lower()
                if value not in ("0", "1", "false", "true", "no", "yes"): fail("PAUSE_FULLSCREEN must be 0/1, false/true, or no/yes")
                out["pause_fullscreen"] = value in ("1", "true", "yes")
            else: fail(f"unsupported config line: {raw}")
    if len(out["roles"]) != 4 or any(r not in ROLES for r in out["roles"]): fail("ROLES must contain four allowed roles")
    if not 100 <= out["fade"] <= 10000: fail("FADE_MS must be 100..10000")
    if not out["fade"] <= out["blur"] <= 10000: fail("BLUR_MS must be FADE_MS..10000")
    if not 0.0 <= out["peak"] <= 8.0: fail("BLUR_PEAK must be 0.0..8.0")
    if out["hwdec"] not in ("nvdec-copy", "cuda-copy", "no"): fail("HWDEC must be nvdec-copy, cuda-copy, or no")
    return out
def check():
    cfg = config()
    for command in ("mpv", "xwinwrap", "xprop"):
        if not shutil.which(command): fail(f"missing command: {command}")
    if not SHIM.is_file() or not os.access(SHIM, os.X_OK): fail(f"missing executable shim: {SHIM}")
    if not SHADER.is_file(): fail(f"missing transition shader: {SHADER}")
    for role in ROLES:
        if not video(role).is_file(): fail(f"missing video: {video(role)}")
    return cfg
def proc(pid):
    path = Path("/proc") / str(pid)
    try:
        comm = (path / "comm").read_text().strip(); argv = [x.decode(errors="replace") for x in (path / "cmdline").read_bytes().rstrip(b"\0").split(b"\0")]
        return comm, argv, int((path / "stat").read_text().split()[3])
    except (OSError, ValueError): return "", [], -1
def kill(pid, name):
    if proc(pid)[0] != name: return
    try: os.kill(pid, signal.SIGTERM)
    except ProcessLookupError: return
    for _ in range(30):
        if proc(pid)[0] != name: return
        time.sleep(.05)
    if proc(pid)[0] == name: os.kill(pid, signal.SIGKILL)
def direct_renderers():
    videos = {str(video(role)) for role in ROLES}; found = []
    for path in Path("/proc").glob("[0-9]*"):
        comm, argv, _ = proc(int(path.name))
        if comm == "xwinwrap" and str(SHIM) in argv and videos.intersection(argv): found.append(int(path.name))
    return found
def stop_direct():
    found = direct_renderers()
    for xww in found:
        for path in Path("/proc").glob("[0-9]*"):
            pid = int(path.name)
            if proc(pid)[2] == xww: kill(pid, "mpv")
        kill(xww, "xwinwrap")
    return len(found)
class IPC:
    def __init__(self): sock = socket.socket(socket.AF_UNIX); sock.settimeout(4); sock.connect(str(SOCK)); self.sock, self.file, self.number = sock, sock.makefile("rwb", buffering=0), 0
    def call(self, *args):
        self.number += 1; request = {"command": list(args), "request_id": self.number}
        self.file.write(json.dumps(request, separators=(",", ":")).encode() + b"\n")
        while True:
            reply = json.loads(self.file.readline())
            if reply.get("request_id") == self.number:
                if reply.get("error") != "success":
                    raise RuntimeError(f"mpv {args[0]}: {reply.get('error')}")
                return reply.get("data")
    def close(self): self.file.close(); self.sock.close()
def steady(role, ids): return f"[vid{ids[role]}]null[vo]"
def set_steady(ipc, role, ids):
    graph = steady(role, ids)
    ipc.call("set_property", "lavfi-complex", graph)
    return graph
def selected_video_tracks(tracks):
    return [track.get("id") for track in tracks if track.get("type") == "video" and track.get("selected")]
def active_window_id(line):
    match = re.search(r"window id #\s*(0x[0-9a-fA-F]+)", line)
    return match.group(1).lower() if match and match.group(1) != "0x0" else ""
def fullscreen_state(line): return "_NET_WM_STATE_FULLSCREEN" in line
def active_fullscreen():
    try:
        root = subprocess.run(["xprop", "-root", "_NET_ACTIVE_WINDOW"], text=True, capture_output=True, timeout=.4, check=False)
        if root.returncode != 0: return None, ""
        window = active_window_id(root.stdout)
        if not window: return False, ""
        state = subprocess.run(["xprop", "-id", window, "_NET_WM_STATE"], text=True, capture_output=True, timeout=.4, check=False)
        if state.returncode != 0: return None, window
        return fullscreen_state(state.stdout), window
    except (OSError, subprocess.TimeoutExpired):
        # A transient X/property failure must not wake a paused renderer.
        return None, ""
def set_pause(ipc, enabled): ipc.call("set_property", "pause", bool(enabled))
def rss_kib(pid):
    try:
        match = re.search(r"^VmRSS:\s+(\d+)\s+kB$", (Path("/proc") / str(pid) / "status").read_text(), re.MULTILINE)
        return int(match.group(1)) if match else 0
    except OSError: return 0
def cpu_percent(pid, interval=.2):
    def ticks():
        try:
            fields = (Path("/proc") / str(pid) / "stat").read_text().split()
            return int(fields[13]) + int(fields[14])
        except (OSError, ValueError, IndexError): return None
    first = ticks()
    if first is None: return 0.0
    before = time.monotonic(); time.sleep(interval); after = time.monotonic(); second = ticks()
    if second is None or after <= before: return 0.0
    return (second - first) / os.sysconf("SC_CLK_TCK") / (after - before) * 100.0
def nvidia_snapshot():
    if not shutil.which("nvidia-smi"): return "UNAVAILABLE (nvidia-smi missing)"
    try:
        result = subprocess.run(["nvidia-smi", "--query-gpu=utilization.gpu,utilization.decoder,memory.used", "--format=csv,noheader,nounits"], text=True, capture_output=True, timeout=1, check=False)
        return result.stdout.strip().replace("\n", ";") if result.returncode == 0 else f"UNAVAILABLE (rc={result.returncode})"
    except (OSError, subprocess.TimeoutExpired): return "UNAVAILABLE (query failed)"
def blend(weights, target, ids, frames, delay=0):
    active = [target] + [r for r in ROLES if r != target and weights.get(r, 0) > .0001]
    if len(active) == 1: return steady(target, ids)
    total = sum(weights.get(r, 0) for r in active) or 1; start = {r: weights.get(r, 0) / total for r in active}
    source, chains, commands, cumulative = f"[vid{ids[target]}]", [], [], start[target]
    u = f"min(max((N-{delay})/{frames}\\\\,0)\\\\,1)" if delay else f"min(N/{frames}\\\\,1)"
    for index, role in enumerate(active[1:], 1):
        cumulative += start[role]
        initial = start[role] / cumulative
        opacity = f"({start[role]:.8f}*(1-{u}))/({cumulative:.8f}*(1-{u})+{u})"
        output = "[premix]" if index == len(active) - 1 else f"[mix{index}]"
        name = f"xmb{index}"
        chains.append(f"[vid{ids[role]}]{source}blend@{name}=all_mode=normal:all_opacity={initial:.8f}{output}")
        commands.append(f"[expr] blend@{name} all_opacity {opacity}")
        source = output
    command = ",".join(commands)
    return ";".join(chains) + f";[premix]sendcmd=c='0-999999 {command}'[vo]"
def blur_rise(t):
    t = max(0.0, min(t, 1.0)); return 1.0 if t == 1.0 else math.sin(math.pi / 2.0 * t)
def blur_fall(t):
    t = max(0.0, min(t, 1.0)); return 0.0 if t == 1.0 else math.cos(math.pi / 2.0 * t) ** 4
def slot_at_viewport(line=None):
    if line is None: line = subprocess.run(["xprop", "-root", "_NET_DESKTOP_VIEWPORT"], text=True, capture_output=True, check=True).stdout
    match = re.search(r"=\s*(-?\d+)", line); return max(0, min(3, (int(match.group(1)) + 2240) // 4480)) if match else 0
def role_at_viewport(cfg, line=None): return cfg["roles"][slot_at_viewport(line)]
def launch(cfg, initial):
    order = [initial] + [r for r in ROLES if r != initial]; ids = {role: index + 1 for index, role in enumerate(order)}
    SOCK.unlink(missing_ok=True)
    args = ["xwinwrap", "-b", "-ni", "-s", "-g", "4480x1440+0+0", "-st", "-sp", "-nf", "-ov", "-fdt",
            "--", str(SHIM), "WID", "--no-config", "--loop-file=inf", "--no-audio", "--no-osc", "--no-osd-bar",
            "--no-input-default-bindings", "--no-stop-screensaver", "--panscan=1.0", "--vo=gpu-next",
            f"--hwdec={cfg['hwdec']}", "--framedrop=vo", "--really-quiet", f"--input-ipc-server={SOCK}", f"--lavfi-complex={steady(initial, ids)}"]
    args += [f"--external-file={video(r)}" for r in order[1:]] + [str(video(initial))]
    log = LOG.open("a", buffering=1); xww = subprocess.Popen(args, stdout=log, stderr=subprocess.STDOUT)
    ipc, tracks = None, []
    for _ in range(160):
        if xww.poll() is not None: fail(f"renderer exited {xww.returncode}; inspect {LOG}")
        if ipc is None and SOCK.exists(): ipc = IPC()
        if ipc:
            try: tracks = [t for t in ipc.call("get_property", "track-list") if t.get("type") == "video"]
            except RuntimeError: tracks = []
            ids = {}
            for track in tracks:
                filename = Path(track.get("external-filename", "")).name; ids.update({initial: track.get("id")} if not track.get("external") and not track.get("albumart") else {})
                for role in order[1:]:
                    if filename == video(role).name: ids[role] = track.get("id")
            if set(ids) == set(ROLES) and len(set(ids.values())) == 3:
                # Keep exactly one video track selected while idle. mpv selects
                # every track referenced by lavfi-complex, even at opacity 0.
                set_steady(ipc, initial, ids)
                try:
                    ipc.call("change-list", "glsl-shaders", "set", str(SHADER)); ipc.call("set_property", "glsl-shader-opts", "xmb_strength=0.000")
                except RuntimeError: print("blur shader preload failed; crossfade continues", flush=True)
                return xww, ipc, ids, log
        time.sleep(.05)
    (ipc and ipc.close()); kill(xww.pid, "xwinwrap"); fail(f"track map timeout: {tracks}; inspect {LOG}")
def state_write(xww, role, mode="idle", fullscreen_paused=False):
    mpv_pid = 0
    try:
        previous = json.loads(STATE.read_text())
        candidate = int(previous.get("mpv", 0))
        comm, _, parent = proc(candidate)
        if comm == "mpv" and parent == xww.pid: mpv_pid = candidate
    except (OSError, ValueError, json.JSONDecodeError): pass
    if not mpv_pid:
        for path in Path("/proc").glob("[0-9]*"):
            pid = int(path.name); comm, _, parent = proc(pid)
            if parent == xww.pid and comm == "mpv": mpv_pid = pid; break
    data = {"controller": os.getpid(), "xwinwrap": xww.pid, "mpv": mpv_pid,
            "role": role, "mode": mode, "fullscreen_paused": fullscreen_paused}
    temp = STATE.with_suffix(".tmp"); temp.write_text(json.dumps(data) + "\n"); temp.replace(STATE)
def run(replace):
    global stop_now
    cfg = check(); RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = (RUN / "controller.lock").open("w")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError: fail("controller already running")
    PID.write_text(f"{os.getpid()}\n"); signal.signal(signal.SIGTERM, lambda *_: globals().__setitem__("stop_now", True))
    if shutil.which("xfdesktop"): subprocess.run(["xfdesktop", "--quit"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL); time.sleep(.5)
    if direct_renderers():
        if not replace: fail("direct wallpaper is live; use start --replace")
        print(f"stopped-direct={stop_direct()}", flush=True)
    initial_slot = slot_at_viewport(); initial, xww, ipc, log, watch = cfg["roles"][initial_slot], None, None, None, None
    try:
        xww, ipc, ids, log = launch(cfg, initial); state_write(xww, initial)
        watch = subprocess.Popen(["xprop", "-root", "-spy", "_NET_DESKTOP_VIEWPORT"], stdout=subprocess.PIPE); os.set_blocking(watch.stdout.fileno(), False)
        duration = cfg["fade"] / 1000
        peak, strength_last, blur_fail = cfg["peak"], -1.0, 0
        burst_start, burst_hops, burst_steps, burst_max, idle_at = 0.0, 0, 0, 0.0, 0.0
        cur_duration, cur_rise, cur_fall = duration, max(duration * 0.214, 0.03), max(duration * 0.6, 0.1)
        fade_frames = round(duration * 60)
        current_slot, current_role, target_slot, target_role = initial_slot, initial, initial_slot, initial
        active, started, events, event_buf = False, 0.0, collections.deque(), b""; blur_on = False
        fullscreen_paused, fullscreen_window, fullscreen_poll = False, "", 0.0
        while not stop_now and xww.poll() is None:
            if select.select([watch.stdout], [], [], .016 if blur_on or active else .05)[0]:
                chunk = os.read(watch.stdout.fileno(), 65536); chunk or fail("xprop watcher exited")
                event_buf += chunk; lines = event_buf.split(b"\n"); event_buf = lines.pop()
                for raw in lines:
                    desired = slot_at_viewport(raw.decode(errors="replace")); planned = events[-1] if events else (target_slot if active else current_slot)
                    if desired != planned:
                        events.clear(); events.append(desired)
            now = time.monotonic()
            if cfg["pause_fullscreen"] and now >= fullscreen_poll and not active and not blur_on:
                should_pause, window = active_fullscreen(); fullscreen_poll = now + 1.0
                if should_pause is not None and should_pause != fullscreen_paused:
                    set_pause(ipc, should_pause); fullscreen_paused, fullscreen_window = should_pause, window
                    mode = "fullscreen-paused" if should_pause else ("transition" if active else ("blur-release" if blur_on else "idle"))
                    state_write(xww, target_role if active else current_role, mode, fullscreen_paused)
                    print(f"fullscreen-pause={'on' if should_pause else 'off'} window={window or fullscreen_window or 'none'}", flush=True)
            if active and now - started >= cur_duration:
                current_slot, current_role, active = target_slot, target_role, False
                print(f"complete slot={current_slot + 1} role={current_role} queued={len(events)}", flush=True)
                if not events: set_steady(ipc, current_role, ids)
                mode = "fullscreen-paused" if fullscreen_paused else ("blur-release" if blur_on else "idle")
                state_write(xww, current_role, mode, fullscreen_paused)
            if not active and events:
                target_slot = events.popleft(); target_role = cfg["roles"][target_slot]
                if target_slot == current_slot: continue
                if target_role == current_role:
                    # A viewport move with identical content needs no second
                    # decoder, blend, or blur pass.
                    current_slot = target_slot; set_steady(ipc, current_role, ids)
                    mode = "fullscreen-paused" if fullscreen_paused else ("blur-release" if blur_on else "idle")
                    state_write(xww, current_role, mode, fullscreen_paused)
                    print(f"same-role slot={current_slot + 1} role={current_role} effect=skipped", flush=True)
                    continue
                frac = min(max(strength_last / peak, 0.0), 1.0) if blur_on and peak > 0 else 0.0
                burst_start = now - math.asin(frac) / (math.pi / 2.0) * cur_rise
                if not blur_on:
                    blur_on = True
                    strength_last, blur_fail, idle_at = 0.0, 0, 0.0
                    burst_hops, burst_steps, burst_max = 1, 0, 0.0
                else:
                    burst_hops += 1; idle_at = 0.0
                print(f"start slot={current_slot + 1}->{target_slot + 1} role={current_role}->{target_role} queued={len(events)}", flush=True)
                ipc.call("set_property", "lavfi-complex", blend({current_role: 1.}, target_role, ids, fade_frames, 0))
                active, started = True, now
                state_write(xww, target_role, "fullscreen-paused" if fullscreen_paused else "transition", fullscreen_paused)
            if blur_on:
                if active and now - burst_start < cur_rise:
                    target = peak * blur_rise((now - burst_start) / cur_rise)
                else:
                    if not idle_at:
                        idle_at = burst_start + cur_rise if active else now
                        target = peak
                    else:
                        target = peak * blur_fall((now - idle_at) / cur_fall)
                burst_max = max(burst_max, target)
                if blur_fail < 3 and (abs(target - strength_last) >= 0.02 or (target != strength_last and target in (0.0, peak))):
                    try:
                        ipc.call("set_property", "glsl-shader-opts", f"xmb_strength={target:.3f}")
                        strength_last, burst_steps = target, burst_steps + 1
                    except RuntimeError:
                        blur_fail += 1
                        if blur_fail == 3: print("blur animation disabled: glsl-shader-opts unsupported; crossfade continues", flush=True)
                if idle_at and now - idle_at >= cur_fall:
                    if strength_last != 0.0:
                        try:
                            ipc.call("set_property", "glsl-shader-opts", "xmb_strength=0.000")
                        except RuntimeError:
                            # Never leave a costly/visible pass stuck on after
                            # repeated option failures. Crossfade can continue.
                            try: ipc.call("set_property", "glsl-shaders", [])
                            except RuntimeError: pass
                    blur_on, strength_last = False, 0.0
                    mode = "fullscreen-paused" if fullscreen_paused else ("transition" if active else "idle")
                    state_write(xww, target_role if active else current_role, mode, fullscreen_paused)
                    print(f"blur burst hops={burst_hops} peak={peak:.3f} max={burst_max:.3f} steps={burst_steps} rise_ms={round(cur_rise * 1000)} fall_ms={round(cur_fall * 1000)} state={'OK' if blur_fail == 0 else 'DEGRADED'}", flush=True)
        if xww.poll() is not None: fail(f"renderer exited; inspect {LOG}")
    finally:
        if watch: watch.terminate()
        if ipc:
            try: ipc.call("quit")
            except Exception: pass
            ipc.close()
        if xww: kill(xww.pid, "xwinwrap")
        if log: log.close()
        for path in (PID, STATE, SOCK): path.unlink(missing_ok=True)
def live_pid():
    try: pid = int(PID.read_text())
    except (OSError, ValueError): return 0
    comm, argv, _ = proc(pid)
    return pid if comm.startswith("python") and any("xmb-wallpaper-controller" in x for x in argv) else 0
def start(replace):
    if live_pid(): fail("controller already running")
    RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE.unlink(missing_ok=True)
    command = [str(Path(__file__).resolve()), "run"] + (["--replace"] if replace else [])
    with LOG.open("a") as log:
        child = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(160):
        if STATE.is_file() and live_pid():
            print(STATE.read_text().strip()); print("XMB_CONTROLLER_START=PASS"); return
        if child.poll() is not None: fail(f"start failed; inspect {LOG}")
        time.sleep(.05)
    fail(f"start timed out; inspect {LOG}")
def stop(restore=False):
    pid = live_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(100):
            if not live_pid(): break
            time.sleep(.05)
        if live_pid(): fail("controller did not stop")
    if restore:
        env = os.environ.copy(); env["XMB_USE_GEOMETRY"] = "1"
        subprocess.run([str(Path.home() / ".local/bin/xmb-wallpaper"), "main-red", "background"], env=env, check=True)
    print("XMB_CONTROLLER_RESTORE=PASS" if restore else "XMB_CONTROLLER_STOP=PASS")
def status():
    if not live_pid(): print("XMB_CONTROLLER_STATUS=STOPPED"); return 1
    raw = STATE.read_text().strip(); print(raw)
    try: data = json.loads(raw)
    except json.JSONDecodeError: data = {}
    mpv_pid = int(data.get("mpv", 0) or 0)
    print(f"mode={data.get('mode', 'unknown')}")
    print(f"fullscreen-paused={str(bool(data.get('fullscreen_paused'))).lower()}")
    print(f"mpv-rss-kib={rss_kib(mpv_pid)}")
    print(f"mpv-cpu-percent={cpu_percent(mpv_pid):.1f}")
    print(f"nvidia-gpu-percent,decoder-percent,memory-used-mib={nvidia_snapshot()}")
    ipc = IPC()
    try:
        tracks = ipc.call("get_property", "track-list")
        selected = selected_video_tracks(tracks)
        videos = [track for track in tracks if track.get("type") == "video"]
        print(f"selected-video-track-count={len(selected)}")
        print(f"selected-video-track-ids={','.join(map(str, selected)) or 'none'}")
        print(f"loaded-video-track-count={len(videos)}")
    except RuntimeError as error:
        print(f"selected-video-track-count=UNAVAILABLE ({error})")
    for name in ("lavfi-complex", "glsl-shaders", "pause", "hwdec-current", "vo-drop-frame-count", "decoder-frame-drop-count", "estimated-vf-fps"):
        try: value = ipc.call("get_property", name)
        except RuntimeError as error: value = f"UNAVAILABLE ({error})"
        print(f"{name}={value}")
    ipc.close(); print("XMB_CONTROLLER_STATUS=RUNNING"); return 0
def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    if action == "run": run("--replace" in sys.argv)
    elif action == "start": check(); start("--replace" in sys.argv)
    elif action == "--check": cfg = check(); print(f"roles={' '.join(cfg['roles'])} fade_ms={cfg['fade']} blur_ms={cfg['blur']} peak={cfg['peak']} hwdec={cfg['hwdec']} pause_fullscreen={str(cfg['pause_fullscreen']).lower()}"); print("XMB_CONTROLLER_CHECK=PASS")
    elif action == "--status": raise SystemExit(status())
    elif action == "--stop": stop()
    elif action == "--restore": stop(True)
    else: fail("usage: xmb-wallpaper-controller [start --replace|--check|--status|--stop|--restore]")
if __name__ == "__main__": main()
