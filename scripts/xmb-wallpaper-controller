#!/usr/bin/env python3
"""One-window, IPC-controlled XMB workspace renderer (U-070)."""
import fcntl, json, os, re, select, shlex, shutil, signal, socket, subprocess, sys, time
from pathlib import Path

ROOT = Path(os.getenv("XMB_BAKE_ROOT", "/mnt/games/xmb-wave-bake"))
CFG = Path(os.getenv("XMB_CONFIG", Path.home() / ".config/xmb-wallpaper.conf"))
RUN = Path(os.getenv("XDG_RUNTIME_DIR", "/tmp")) / f"xmb-wallpaper-{os.getuid()}"
PID, STATE, SOCK = (RUN / name for name in ("controller.pid", "state.json", "mpv.sock"))
LOG = Path(os.getenv("XMB_CONTROLLER_LOG", "/tmp/xmb-wallpaper-controller.log"))
SHIM = Path(os.getenv("XMB_SHIM", Path.home() / ".local/bin/mpv-xwinwrap-shim"))
ROLES = ("main-red", "work-monochrome", "sleep")
stop_now = False


def fail(text):
    print(f"xmb-controller: {text}", file=sys.stderr)
    raise SystemExit(2)


def video(role):
    return ROOT / "out" / role / f"{role}.loop-60s.mp4"


def config():
    out = {"roles": ["main-red", "work-monochrome", "work-monochrome", "main-red"],
           "fade": 4000, "hwdec": "nvdec-copy"}
    if CFG.is_file():
        for raw in CFG.read_text().splitlines():
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            match = re.fullmatch(r"ROLES=\((.*)\)", line)
            if match:
                out["roles"] = shlex.split(match.group(1))
            elif line.startswith("FADE_MS="):
                out["fade"] = int(line.split("=", 1)[1])
            elif line.startswith("HWDEC="):
                out["hwdec"] = line.split("=", 1)[1].strip()
            else:
                fail(f"unsupported config line: {raw}")
    if len(out["roles"]) != 4 or any(r not in ROLES for r in out["roles"]):
        fail("ROLES must contain four allowed roles")
    if not 100 <= out["fade"] <= 10000:
        fail("FADE_MS must be 100..10000")
    if out["hwdec"] not in ("nvdec-copy", "cuda-copy", "no"):
        fail("HWDEC must be nvdec-copy, cuda-copy, or no")
    return out


def check():
    cfg = config()
    for command in ("mpv", "xwinwrap", "xprop"):
        if not shutil.which(command):
            fail(f"missing command: {command}")
    if not SHIM.is_file() or not os.access(SHIM, os.X_OK):
        fail(f"missing executable shim: {SHIM}")
    for role in ROLES:
        if not video(role).is_file():
            fail(f"missing video: {video(role)}")
    return cfg


def proc(pid):
    path = Path("/proc") / str(pid)
    try:
        comm = (path / "comm").read_text().strip()
        argv = [x.decode(errors="replace") for x in
                (path / "cmdline").read_bytes().rstrip(b"\0").split(b"\0")]
        return comm, argv, int((path / "stat").read_text().split()[3])
    except (OSError, ValueError):
        return "", [], -1


def kill(pid, name):
    if proc(pid)[0] != name:
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    for _ in range(30):
        if proc(pid)[0] != name:
            return
        time.sleep(.05)
    if proc(pid)[0] == name:
        os.kill(pid, signal.SIGKILL)


def direct_renderers():
    videos = {str(video(role)) for role in ROLES}
    found = []
    for path in Path("/proc").glob("[0-9]*"):
        comm, argv, _ = proc(int(path.name))
        if comm == "xwinwrap" and str(SHIM) in argv and videos.intersection(argv):
            found.append(int(path.name))
    return found


def stop_direct():
    found = direct_renderers()
    for xww in found:
        for path in Path("/proc").glob("[0-9]*"):
            pid = int(path.name)
            if proc(pid)[2] == xww:
                kill(pid, "mpv")
        kill(xww, "xwinwrap")
    return len(found)


class IPC:
    def __init__(self):
        sock = socket.socket(socket.AF_UNIX)
        sock.settimeout(4)
        sock.connect(str(SOCK))
        self.sock, self.file, self.number = sock, sock.makefile("rwb", buffering=0), 0

    def call(self, *args):
        self.number += 1
        request = {"command": list(args), "request_id": self.number}
        self.file.write(json.dumps(request, separators=(",", ":")).encode() + b"\n")
        while True:
            reply = json.loads(self.file.readline())
            if reply.get("request_id") == self.number:
                if reply.get("error") != "success":
                    raise RuntimeError(f"mpv {args[0]}: {reply.get('error')}")
                return reply.get("data")

    def close(self):
        self.file.close(); self.sock.close()


def steady(role, ids):
    return f"[vid{ids[role]}]null[vo]"


def blend(weights, target, ids, frames):
    active = [target] + [r for r in ROLES if r != target and weights.get(r, 0) > .0001]
    if len(active) == 1:
        return steady(target, ids)
    total = sum(weights.get(r, 0) for r in active) or 1
    start = {r: weights.get(r, 0) / total for r in active}
    source, chains, commands, cumulative = f"[vid{ids[target]}]", [], [], start[target]
    u = f"min(N/{frames}\\\\,1)"
    for index, role in enumerate(active[1:], 1):
        cumulative += start[role]
        initial = start[role] / cumulative
        opacity = f"({start[role]:.8f}*(1-{u}))/({cumulative:.8f}*(1-{u})+{u})"
        output = "[premix]" if index == len(active) - 1 else f"[mix{index}]"
        name = f"xmb{index}"
        chains.append(f"[vid{ids[role]}]{source}blend@{name}="
                      f"all_mode=normal:all_opacity={initial:.8f}{output}")
        commands.append(f"[expr] blend@{name} all_opacity {opacity}")
        source = output
    command = ",".join(commands)
    return ";".join(chains) + f";[premix]sendcmd=c='0-999999 {command}'[vo]"


def weights(state):
    start, target, began, duration = state
    progress = min(1., max(0., time.monotonic() - began) / duration)
    out = {r: value * (1 - progress) for r, value in start.items()}
    out[target] = out.get(target, 0) + progress
    return {r: value for r, value in out.items() if value > .0001}


def role_at_viewport(cfg, line=None):
    if line is None:
        line = subprocess.run(["xprop", "-root", "_NET_DESKTOP_VIEWPORT"],
                              text=True, capture_output=True, check=True).stdout
    match = re.search(r"=\s*(-?\d+)", line)
    slot = max(0, min(3, (int(match.group(1)) + 2240) // 4480)) if match else 0
    return cfg["roles"][slot]


def launch(cfg, initial):
    order = [initial] + [r for r in ROLES if r != initial]
    ids = {role: index + 1 for index, role in enumerate(order)}
    SOCK.unlink(missing_ok=True)
    args = ["xwinwrap", "-b", "-ni", "-s", "-g", "4480x1440+0+0", "-st", "-sp",
            "-nf", "-ov", "-fdt", "--", str(SHIM), "WID", "--no-config",
            "--loop-file=inf", "--no-audio", "--no-osc", "--no-osd-bar",
            "--no-input-default-bindings", "--no-stop-screensaver", "--panscan=1.0",
            "--vo=gpu-next", f"--hwdec={cfg['hwdec']}", "--framedrop=vo",
            f"--input-ipc-server={SOCK}", f"--lavfi-complex={steady(initial, ids)}"]
    args += [f"--external-file={video(r)}" for r in order[1:]] + [str(video(initial))]
    log = LOG.open("a", buffering=1)
    xww = subprocess.Popen(args, stdout=log, stderr=subprocess.STDOUT)
    for _ in range(160):
        if xww.poll() is not None:
            fail(f"renderer exited {xww.returncode}; inspect {LOG}")
        if SOCK.exists():
            ipc = IPC()
            tracks = [t for t in ipc.call("get_property", "track-list") if t.get("type") == "video"]
            if len(tracks) < 3 or {t.get("id") for t in tracks} != {1, 2, 3}:
                fail("mpv did not expose expected video track IDs 1,2,3")
            return xww, ipc, ids, log
        time.sleep(.05)
    kill(xww.pid, "xwinwrap"); fail(f"no mpv IPC socket; inspect {LOG}")


def state_write(xww, role):
    children = [int(p.name) for p in Path("/proc").glob("[0-9]*")
                if proc(int(p.name))[2] == xww.pid and proc(int(p.name))[0] == "mpv"]
    data = {"controller": os.getpid(), "xwinwrap": xww.pid,
            "mpv": children[0] if children else 0, "role": role}
    temp = STATE.with_suffix(".tmp"); temp.write_text(json.dumps(data) + "\n"); temp.replace(STATE)


def run(replace):
    global stop_now
    cfg = check(); RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock = (RUN / "controller.lock").open("w")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError: fail("controller already running")
    PID.write_text(f"{os.getpid()}\n")
    signal.signal(signal.SIGTERM, lambda *_: globals().__setitem__("stop_now", True))
    if direct_renderers():
        if not replace: fail("direct wallpaper is live; use start --replace")
        print(f"stopped-direct={stop_direct()}", flush=True)
    initial, xww, ipc, log, watch = role_at_viewport(cfg), None, None, None, None
    try:
        xww, ipc, ids, log = launch(cfg, initial); state_write(xww, initial)
        watch = subprocess.Popen(["xprop", "-root", "-spy", "_NET_DESKTOP_VIEWPORT"],
                                 text=True, stdout=subprocess.PIPE)
        duration = cfg["fade"] / 1000
        fade = ({initial: 1.}, initial, time.monotonic(), duration)
        while not stop_now and xww.poll() is None:
            ready, _, _ = select.select([watch.stdout], [], [], .05)
            if ready:
                line = watch.stdout.readline()
                if not line: fail("xprop watcher exited")
                desired = role_at_viewport(cfg, line)
                while select.select([watch.stdout], [], [], 0)[0]:
                    line = watch.stdout.readline()
                    if not line: fail("xprop watcher exited")
                    desired = role_at_viewport(cfg, line)
                current = weights(fade)
                if desired != fade[1]:
                    ipc.call("set_property", "lavfi-complex",
                             blend(current, desired, ids, round(duration * 60)))
                    fade = (current, desired, time.monotonic(), duration)
                    state_write(xww, desired)
            if time.monotonic() - fade[2] >= fade[3] and len(fade[0]) != 0:
                ipc.call("set_property", "lavfi-complex", steady(fade[1], ids))
                fade = ({}, fade[1], time.monotonic(), duration)
        if xww.poll() is not None: fail(f"renderer exited; inspect {LOG}")
    finally:
        if watch: watch.terminate()
        if ipc:
            try: ipc.call("quit")
            except Exception: pass
            ipc.close()
        if xww: kill(xww.pid, "xwinwrap")
        if log: log.close()
        for path in (PID, STATE, SOCK): path.unlink(missing_ok=True)


def live_pid():
    try: pid = int(PID.read_text())
    except (OSError, ValueError): return 0
    comm, argv, _ = proc(pid)
    return pid if comm.startswith("python") and any("xmb-wallpaper-controller" in x for x in argv) else 0


def start(replace):
    if live_pid(): fail("controller already running")
    RUN.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE.unlink(missing_ok=True)
    command = [str(Path(__file__).resolve()), "run"] + (["--replace"] if replace else [])
    with LOG.open("a") as log:
        child = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(160):
        if STATE.is_file() and live_pid():
            print(STATE.read_text().strip()); print("XMB_CONTROLLER_START=PASS"); return
        if child.poll() is not None: fail(f"start failed; inspect {LOG}")
        time.sleep(.05)
    fail(f"start timed out; inspect {LOG}")


def stop(restore=False):
    pid = live_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(100):
            if not live_pid(): break
            time.sleep(.05)
        if live_pid(): fail("controller did not stop")
    if restore:
        env = os.environ.copy(); env["XMB_USE_GEOMETRY"] = "1"
        subprocess.run([str(Path.home() / ".local/bin/xmb-wallpaper"),
                        "main-red", "background"], env=env, check=True)
    print("XMB_CONTROLLER_RESTORE=PASS" if restore else "XMB_CONTROLLER_STOP=PASS")


def status():
    if not live_pid(): print("XMB_CONTROLLER_STATUS=STOPPED"); return 1
    print(STATE.read_text().strip())
    ipc = IPC()
    for name in ("lavfi-complex", "vo-drop-frame-count", "decoder-frame-drop-count"):
        print(f"{name}={ipc.call('get_property', name)}")
    ipc.close(); print("XMB_CONTROLLER_STATUS=RUNNING"); return 0


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    if action == "run": run("--replace" in sys.argv)
    elif action == "start": check(); start("--replace" in sys.argv)
    elif action == "--check":
        cfg = check(); print(f"roles={' '.join(cfg['roles'])} fade_ms={cfg['fade']} hwdec={cfg['hwdec']}")
        print("XMB_CONTROLLER_CHECK=PASS")
    elif action == "--status": raise SystemExit(status())
    elif action == "--stop": stop()
    elif action == "--restore": stop(True)
    else: fail("usage: xmb-wallpaper-controller [start --replace|--check|--status|--stop|--restore]")


if __name__ == "__main__": main()
