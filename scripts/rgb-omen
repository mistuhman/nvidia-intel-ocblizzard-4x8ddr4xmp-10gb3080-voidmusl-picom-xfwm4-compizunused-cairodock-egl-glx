#!/bin/sh
# scripts/rgb-omen - HP OMEN TracerLED (USB 103c:84fd) per-zone control + boot persistence
# Zones: 1=Logo, 2=Light Bar, 3=Front Fan, 4=CPU, 5=Bottom Fan, 6=Middle Fan, 7=Top Fan.
# OpenRGB exposes only one device-wide mode. This script drives the 58-byte HID protocol directly
# to allow per-zone modes (e.g. Wave on all fans while Logo/Bar/CPU stay solid static).
#
# Debug status light (2026-08-30): `health` paints one zone (default 4=CPU LED) with system
# state - green OK / amber warn / red crit / magenta scrub - while the fans keep the art wave.
# SMOOTH APPLY (operator directive 2026-08-30): `apply HEX [FROM_HEX] [STEPS] [DELAY_MS]`
# fades the ENTIRE layout (statics + fan wave, all 7 zones) to the target color ONCE, and
# nothing repaints after it. Defaults are QUICK (10 steps x 20 ms ~ 0.3 s) per operator
# "the fades kinda slow, just a quick transition" (2026-08-30, second receipt).
# `preview [HOLD_MS] [STEPS] [DELAY_MS]` quick-cycles a named 12-color palette (~2.5 s each)
# for on-hardware color selection, then returns to the last applied color. `persist apply
# HEX 000000` = boot fade-in from black, once per boot. `health` / `persist-health` are
# ON-DEMAND only - not the boot path. See docs/feature-pack-accessories.md for the hardware
# debug channels this complements.

set -u
SVC_DIR="/etc/sv/omen-rgb"
SVC_LINK="/var/service/omen-rgb"
HSVC_DIR="/etc/sv/omen-rgb-health"
HSVC_LINK="/var/service/omen-rgb-health"
USER_CFG="/home/sd/.config/OpenRGB"
ROOT_CFG="/root/.config/OpenRGB"
HUB_ID="103c:84fd"

die() { echo "rgb-omen: $*" >&2; exit 1; }

run_py() {
    python3 - "$@" <<'PYEOF'
import sys, os, glob

FAN_ZONES, STATIC_ZONES, ALL_ZONES = [3, 5, 6, 7], [1, 2, 4], list(range(1, 8))
MODES = {'static': 1, 'direct': 4, 'off': 5, 'breathing': 6, 'cycle': 7, 'blinking': 8, 'wave': 9, 'radial': 10}
SPEEDS = {'slow': 1, 'med': 2, 'medium': 2, 'fast': 3, '1': 1, '2': 2, '3': 3}

def find_dev():
    for p in glob.glob('/sys/class/hidraw/hidraw*'):
        ue = os.path.join(p, 'device', 'uevent')
        if os.path.isfile(ue) and '103C' in open(ue).read().upper() and '84FD' in open(ue).read().upper():
            return os.path.join('/dev', os.path.basename(p))
    return '/dev/hidraw0' if os.path.exists('/dev/hidraw0') else None

def parse_rgb(v):
    v = v.lstrip('#')
    return tuple(int(v[i:i+2], 16) for i in (0, 2, 4)) if len(v) == 6 else tuple(int(v[i]*2, 16) for i in range(3))

def build_rep(zone, mode, col, spd=2):
    idx, reps = zone - 1, []
    if mode == 5: # OFF
        b = bytearray(58); b[2], b[3], b[54], b[55] = 0x12, 5, zone, 1
        return [bytes(b)]
    if mode == 1: # STATIC
        b = bytearray(58); b[2], b[3], b[4], b[5], b[48], b[49], b[54], b[55], b[57] = 0x12, 1, 1, 1, 100, 2, zone, 1, spd
        b[8+idx*3], b[9+idx*3], b[10+idx*3] = col[0], col[1], col[2]
        return [bytes(b)]
    # WAVE / changing
    cols = [(int(col[0]*f), int(col[1]*f), int(col[2]*f)) for f in (0.1, 0.35, 0.7, 1.0, 0.7, 0.35)] if mode == 9 else [col]
    for i, c in enumerate(cols):
        b = bytearray(58); b[2], b[3], b[4], b[5], b[48], b[49], b[54], b[55], b[57] = 0x12, mode, len(cols), i+1, 100, 10, zone, 1, spd
        b[8+idx*3], b[9+idx*3], b[10+idx*3] = c[0], c[1], c[2]
        reps.append(bytes(b))
    return reps

def send(dev, reps):
    with open(dev, 'wb') as f:
        for r in reps: f.write(r); f.flush()

HEALTH_COLORS = {'ok': '00ff00', 'warn': 'ffb400', 'crit': 'ff2000', 'scrub': 'ff00ff'}
HEALTH_RANK = {'ok': 0, 'scrub': 1, 'warn': 2, 'crit': 3}

def health_eval():
    # Read-only system probes -> (state, reasons, details). Never stresses anything.
    import subprocess, re, glob as g
    state, reasons, det = 'ok', [], {}

    ps = ''
    try:
        ps = subprocess.run(['zpool', 'status'], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        det['pools'] = 'unreadable'
    if ps:
        bad = [w for w in ('FAULTED', 'UNAVAIL', 'OFFLINE') if w in ps]
        if bad: state, _ = 'crit', reasons.append('pool ' + '/'.join(bad))
        elif 'DEGRADED' in ps: state, _ = 'warn', reasons.append('pool DEGRADED')
        det['pools'] = 'bad' if bad or 'DEGRADED' in ps else 'ok'
        det['scrub'] = 'yes' if 'scrub in progress' in ps else 'no'
        if det['scrub'] == 'yes' and HEALTH_RANK['scrub'] > HEALTH_RANK[state]:
            state = 'scrub'

    mce = -1
    try:
        dm = subprocess.run(['dmesg'], capture_output=True, text=True, timeout=10).stdout
        # Error-bearing lines only. Bare 'EDAC' caught version boot noise; bare 'Xid' would
        # catch the r8169 NIC chip-id line "XID 541" (target receipt 2026-08-30). NVIDIA Xid
        # errors always print as "NVRM: Xid (PCI:..):" - anchor on that.
        mce = sum(1 for l in dm.splitlines() if re.search(r'Machine check|Hardware Error|NVRM.*Xid|Xid \(PCI|EDAC.*[Ee]rror', l))
    except Exception:
        pass
    det['mce'] = mce
    if mce > 0 and HEALTH_RANK['crit'] > HEALTH_RANK[state]:
        state, _ = 'crit', reasons.append(f'{mce} MCE/EDAC/Xid line(s) in dmesg')

    ct = None
    for h in g.glob('/sys/class/hwmon/hwmon*'):
        try:
            if open(h + '/name').read().strip() == 'coretemp':
                v = [int(open(t).read()) for t in g.glob(h + '/temp*_input')]
                if v: ct = max(ct or 0, max(v))
        except Exception:
            pass
    det['cpu_c'] = round(ct / 1000) if ct else None
    if ct is not None:
        if ct >= 100000 and HEALTH_RANK['crit'] > HEALTH_RANK[state]:
            state, _ = 'crit', reasons.append(f'cpu {det["cpu_c"]}C')
        elif ct >= 90000 and HEALTH_RANK['warn'] > HEALTH_RANK[state]:
            state, _ = 'warn', reasons.append(f'cpu {det["cpu_c"]}C')

    gt = None
    try:
        o = subprocess.run(['nvidia-smi', '--query-gpu=temperature.gpu', '--format=csv,noheader,nounits'],
                           capture_output=True, text=True, timeout=5).stdout.split()
        gt = int(o[0])
    except Exception:
        pass
    det['gpu_c'] = gt
    if gt is not None:
        if gt >= 85 and HEALTH_RANK['crit'] > HEALTH_RANK[state]:
            state, _ = 'crit', reasons.append(f'gpu {gt}C')
        elif gt >= 80 and HEALTH_RANK['warn'] > HEALTH_RANK[state]:
            state, _ = 'warn', reasons.append(f'gpu {gt}C')

    return state, reasons, det

def lerp(a, b, t):
    return tuple(min(255, max(0, round(a[i] + (b[i] - a[i]) * t))) for i in range(3))

def hexs(c):
    return '%02x%02x%02x' % c

STATE_FILE = '/var/lib/rgb-omen/last-color'

PALETTE = [
    ('red', 'FF0000'), ('green', '1EFF00'), ('purple', '9000FF'), ('orange', 'FF2600'),
]

def layout_reps(col, spd=2):
    return [r for z in STATIC_ZONES for r in build_rep(z, 1, col)] + [r for z in FAN_ZONES for r in build_rep(z, 9, col, spd)]

def fade(dev, start, target, steps, delay_s):
    import time
    for s in range(1, steps + 1):
        send(dev, layout_reps(lerp(start, target, s / steps)))
        time.sleep(delay_s)

def read_last():
    try:
        return parse_rgb(open(STATE_FILE).read().strip())
    except Exception:
        return None

def main():
    act, dev = sys.argv[1], find_dev()
    if not dev: sys.exit("ERROR: TracerLED (103c:84fd) hidraw device not found")
    if act == 'fans-wave':
        col, spd = parse_rgb(sys.argv[2] if len(sys.argv) > 2 else '00d0ff'), SPEEDS.get(sys.argv[3] if len(sys.argv) > 3 else 'med', 2)
        reps = [r for z in STATIC_ZONES for r in build_rep(z, 1, col, spd)] + [r for z in FAN_ZONES for r in build_rep(z, 9, col, spd)]
        send(dev, reps); print(f"FANS_WAVE=OK color=#{sys.argv[2] if len(sys.argv)>2 else '00d0ff'} speed={spd} dev={dev}")
    elif act in ('static', 'color'):
        col = parse_rgb(sys.argv[2] if len(sys.argv) > 2 else '00d0ff')
        send(dev, [r for z in ALL_ZONES for r in build_rep(z, 1, col)])
        print(f"STATIC_ALL=OK color=#{sys.argv[2] if len(sys.argv)>2 else '00d0ff'} dev={dev}")
    elif act == 'wave-all':
        col, spd = parse_rgb(sys.argv[2] if len(sys.argv) > 2 else '00d0ff'), SPEEDS.get(sys.argv[3] if len(sys.argv) > 3 else 'med', 2)
        send(dev, [r for z in ALL_ZONES for r in build_rep(z, 9, col, spd)])
        print(f"WAVE_ALL=OK color=#{sys.argv[2] if len(sys.argv)>2 else '00d0ff'} speed={spd} dev={dev}")
    elif act == 'set-zone':
        z, m, col = int(sys.argv[2]), MODES.get(sys.argv[3].lower(), 1), parse_rgb(sys.argv[4]) if sys.argv[3] != 'off' else (0, 0, 0)
        spd = SPEEDS.get(sys.argv[5] if len(sys.argv) > 5 else 'med', 2)
        send(dev, build_rep(z, m, col, spd)); print(f"SET_ZONE=OK zone={z} mode={sys.argv[3]} dev={dev}")
    elif act == 'health':
        art_hex = (sys.argv[2] if len(sys.argv) > 2 else '031CC0').lstrip('#')
        zsel = sys.argv[3] if len(sys.argv) > 3 else '4'
        art = parse_rgb(art_hex)
        szones = [1, 2, 4] if zsel == 'all' else ([int(zsel)] if zsel.isdigit() and 1 <= int(zsel) <= 7 else [4])
        state, reasons, det = health_eval()
        scol = parse_rgb(HEALTH_COLORS[state])
        reps = [r for z in FAN_ZONES for r in build_rep(z, 9, art, 2)] + [r for z in szones for r in build_rep(z, 1, scol)]
        send(dev, reps)
        print(f"HEALTH={state.upper()} status_color=#{HEALTH_COLORS[state]} zones={szones} art=#{art_hex} dev={dev}")
        print("DETAIL pools={0} scrub={1} mce={2} cpu_c={3} gpu_c={4}".format(
            det.get('pools', '?'), det.get('scrub', '?'), det.get('mce', '?'), det.get('cpu_c'), det.get('gpu_c')))
        if reasons: print("REASON=" + '; '.join(reasons))
    elif act == 'apply':
        target = parse_rgb(sys.argv[2] if len(sys.argv) > 2 else '031CC0')
        steps = int(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4].isdigit() else 10
        delay = (float(sys.argv[5]) / 1000.0) if len(sys.argv) > 5 and sys.argv[5].isdigit() else 0.02
        prev = read_last()
        if len(sys.argv) > 3 and sys.argv[3]:
            start = parse_rgb(sys.argv[3])
        elif prev and prev != target:
            start = prev
        else:
            start = (0, 0, 0)
        try:
            fade(dev, start, target, steps, delay)
        except Exception as e:
            print(f"WARN fade interrupted ({e}); forcing final color")
        send(dev, layout_reps(target))
        try:
            os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
            open(STATE_FILE, 'w').write(hexs(target))
        except Exception:
            pass
        print(f"APPLY=OK smooth from=#{hexs(start)} to=#{hexs(target).upper()} steps={steps} delay_ms={int(delay * 1000)} dev={dev}")
    elif act == 'preview':
        import time
        hold = (float(sys.argv[2]) / 1000.0) if len(sys.argv) > 2 and sys.argv[2].isdigit() else 2.5
        steps = int(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3].isdigit() else 8
        delay = (float(sys.argv[4]) / 1000.0) if len(sys.argv) > 4 and sys.argv[4].isdigit() else 0.02
        back = read_last() or parse_rgb('031CC0')
        print(f"PREVIEW=START colors={len(PALETTE)} hold_s={hold} steps={steps} delay_ms={int(delay * 1000)} dev={dev}")
        cur = back
        for name, hx in PALETTE:
            print(f"SHOW {name} #{hx}")
            tgt = parse_rgb(hx)
            fade(dev, cur, tgt, steps, delay)
            send(dev, layout_reps(tgt))
            time.sleep(hold)
            cur = tgt
        fade(dev, cur, back, steps, delay)
        send(dev, layout_reps(back))
        print(f"PREVIEW=DONE back=#{hexs(back).upper()} (last applied color; state file untouched)")

if __name__ == '__main__': main()
PYEOF
}

cmd_probe() {
    echo "=== USB Hub ==="; lsusb | grep -i "$HUB_ID" || echo "  103c:84fd not found"
    echo "=== OpenRGB Devices ==="; openrgb --list-devices 2>&1 || true
    echo "=== Profiles (user: $USER_CFG) ==="; ls -la "$USER_CFG" 2>/dev/null | grep -E '\.(orp|json)$' || true
    echo "=== Profiles (root: $ROOT_CFG) ==="; ls -la "$ROOT_CFG" 2>/dev/null | grep -E '\.(orp|json)$' || true
    echo "=== Service Status ==="; sv status "$SVC_LINK" 2>&1 || true
}

cmd_fans_wave() { [ "$(id -u)" -eq 0 ] || die "needs root"; run_py fans-wave "${1:-00d0ff}" "${2:-med}"; }
cmd_static()    { [ "$(id -u)" -eq 0 ] || die "needs root"; run_py static "${1:-00d0ff}"; }
cmd_wave_all()  { [ "$(id -u)" -eq 0 ] || die "needs root"; run_py wave-all "${1:-00d0ff}" "${2:-med}"; }
cmd_set_zone()  { [ "$(id -u)" -eq 0 ] || die "needs root"; [ $# -ge 3 ] || die "usage: set-zone ZONE MODE HEX [SPEED]"; run_py set-zone "$@"; }
cmd_color()     { [ "$(id -u)" -eq 0 ] || die "needs root"; run_py static "${1:-00d0ff}"; }
cmd_health()    { [ "$(id -u)" -eq 0 ] || die "needs root"; run_py health "${1:-031CC0}" "${2:-4}"; }
cmd_apply()     { [ "$(id -u)" -eq 0 ] || die "needs root"; run_py apply "${1:-031CC0}" "${2:-}" "${3:-}" "${4:-}"; }
cmd_preview()   { [ "$(id -u)" -eq 0 ] || die "needs root"; run_py preview "${1:-}" "${2:-}" "${3:-}"; }

cmd_profile() {
    [ $# -ge 1 ] || die "usage: profile NAME"
    [ -f "$ROOT_CFG/$1.orp" ] || [ ! -f "$USER_CFG/$1.orp" ] || { mkdir -p "$ROOT_CFG" && cp -f "$USER_CFG/$1.orp" "$ROOT_CFG/$1.orp"; }
    openrgb --profile "$1" 2>&1 && echo "APPLY=OK profile '$1' sent via OpenRGB"
}

cmd_persist() {
    [ "$(id -u)" -eq 0 ] || die "persist needs root"
    subcmd="${1:-fans-wave}"; shift || true
    sp=$(readlink -f "$0" 2>/dev/null || echo "/usr/local/bin/rgb-omen")
    mkdir -p "$SVC_DIR"
    cat > "$SVC_DIR/run" <<EOF
#!/bin/sh
exec 2>&1
i=0; while [ "\$i" -lt 90 ]; do lsusb 2>/dev/null | grep -qi "${HUB_ID}" && break; sleep 2; i=\$((i + 1)); done
sleep 1
[ -x "${sp}" ] && "${sp}" ${subcmd} "$@" || { [ -x "/usr/local/bin/rgb-omen" ] && /usr/local/bin/rgb-omen ${subcmd} "$@"; }
exec sleep 86400
EOF
    chmod 0755 "$SVC_DIR/run"
    mkdir -p /var/service; [ -L "$SVC_LINK" ] || ln -s "$SVC_DIR" "$SVC_LINK" || die "failed to symlink $SVC_LINK"
    echo "PERSIST=OK boot service enabled via $SVC_LINK (${subcmd} $*)"
}

cmd_unpersist() {
    [ "$(id -u)" -eq 0 ] || die "unpersist needs root"
    [ -L "$SVC_LINK" ] && rm -f "$SVC_LINK" && echo "UNPERSIST=OK removed $SVC_LINK" || echo "UNPERSIST=OK no link"
    [ -L "$HSVC_LINK" ] && rm -f "$HSVC_LINK" && echo "UNPERSIST=OK removed $HSVC_LINK" || echo "UNPERSIST=OK no health link"
}

cmd_persist_health() {
    [ "$(id -u)" -eq 0 ] || die "persist-health needs root"
    art="${1:-031CC0}"; zone="${2:-4}"; interval="${3:-15}"
    case "$interval" in ''|*[!0-9]*) die "interval must be seconds";; esac
    sp=$(readlink -f "$0" 2>/dev/null || echo "/usr/local/bin/rgb-omen")
    mkdir -p "$HSVC_DIR"
    cat > "$HSVC_DIR/run" <<EOF
#!/bin/sh
# omen-rgb-health: poll system health and paint the status zone (rgb-omen health).
# REVERSE: rm /var/service/omen-rgb-health
exec 2>&1
i=0; while [ "\$i" -lt 90 ]; do lsusb 2>/dev/null | grep -qi "${HUB_ID}" && break; sleep 2; i=\$((i + 1)); done
sleep 1
while :; do
    if [ -x "${sp}" ]; then "${sp}" health ${art} ${zone}; else /usr/local/bin/rgb-omen health ${art} ${zone}; fi
    sleep ${interval}
done
EOF
    chmod 0755 "$HSVC_DIR/run"
    mkdir -p /var/service; [ -L "$HSVC_LINK" ] || ln -s "$HSVC_DIR" "$HSVC_LINK" || die "failed to symlink $HSVC_LINK"
    echo "PERSIST_HEALTH=OK poll loop enabled via $HSVC_LINK (art=#${art} zone=${zone} every ${interval}s)"
}

cmd_status() {
    echo "=== Service ==="; sv status "$SVC_LINK" 2>&1 || true
    echo "=== Health Service ==="; sv status "$HSVC_LINK" 2>&1 || true
    echo "=== Run Script ==="; [ -f "$SVC_DIR/run" ] && sed -n '1,25p' "$SVC_DIR/run" 2>&1 || echo "(no run file)"
    echo "=== Hub ==="; lsusb | grep -i "$HUB_ID" || echo "(103c:84fd not found)"
}

action="${1:-}"
case "$action" in
probe) cmd_probe ;;
apply) shift; cmd_apply "$@" ;;
preview) shift; cmd_preview "$@" ;;
profile) shift; cmd_profile "$@" ;;
fans-wave) shift; cmd_fans_wave "$@" ;;
static) shift; cmd_static "$@" ;;
wave-all) shift; cmd_wave_all "$@" ;;
set-zone) shift; cmd_set_zone "$@" ;;
color) shift; cmd_color "$@" ;;
health) shift; cmd_health "$@" ;;
persist) shift; cmd_persist "$@" ;;
persist-health) shift; cmd_persist_health "$@" ;;
unpersist) cmd_unpersist ;;
status) cmd_status ;;
*) echo "usage: sh rgb-omen probe|apply|preview|profile|fans-wave|static|wave-all|set-zone|color|health|persist|persist-health|unpersist|status" >&2; exit 1 ;;
esac
