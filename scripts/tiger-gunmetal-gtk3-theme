.menubar {
  min-height: 24px;
  padding: 0 4px;
  background-color: #070707;
  background-image: url("tiger3d/menubar.png");
  background-size: 100% 100%;
  border-top: 1px solid rgba(255,255,255,0.38);
  border-bottom: 1px solid #0b4e7c;
  box-shadow: inset 0 1px rgba(255,255,255,0.10), inset 0 -2px #010101;
  color: #f2f2f2;
