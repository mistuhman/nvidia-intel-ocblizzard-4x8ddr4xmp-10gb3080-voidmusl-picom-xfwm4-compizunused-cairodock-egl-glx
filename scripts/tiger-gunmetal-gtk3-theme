#!/usr/bin/env python3
"""Build the Tiger-Gunmetal-3D GTK3 theme on top of Quake-Gunmetal-3D.

Operator spec 2026-08-22: keep the accepted Quake-Gunmetal surfaces, add
OS X 10.4 brushed-black-gunmetal top bars, and turn every red accent into
Prussian blue. The source theme is copied, never edited; the tiger layer
imports after gunmetal-3d.css so equal specificity resolves to this file.

  tiger-gunmetal-gtk3-theme build  [--source DIR] [--output DIR] [--force]
  tiger-gunmetal-gtk3-theme probe  [--theme NAME] [--baseline NAME]
  tiger-gunmetal-gtk3-theme apply  [--theme NAME]
  tiger-gunmetal-gtk3-theme restore
  tiger-gunmetal-gtk3-theme status
"""

from __future__ import annotations

import argparse
import configparser
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

THEME_NAME = "Tiger-Gunmetal-3D"
SOURCE_NAME = "Quake-Gunmetal-3D"
STATE_FILE = Path.home() / ".local/state/tiger-gunmetal-gtk3/previous-theme"

# Prussian blue ramp shared with the Emerald deco.
PRUSSIAN_DEEP = (0, 26, 46)
PRUSSIAN_BASE = (0, 49, 83)
PRUSSIAN_LIT = (11, 78, 124)
PRUSSIAN_RIM = (47, 124, 178)


def load_sibling(name: str):
    path = Path(__file__).resolve().parent / name
    if not path.is_file():
        raise SystemExit(f"ERROR: required sibling tool missing: {path}")
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


base = load_sibling("gunmetal-gtk3-theme")


def clamp(value: float, low: int = 0, high: int = 255) -> int:
    return max(low, min(high, round(value)))


def brushed(x: int, y: int, amp: int = 4) -> int:
    value = (x * 2654435761 + (y // 3) * 40503 + (x // 23) * 9176 + 0x17A1) & 0xFFFFFFFF
    return (value % (amp * 2 + 1)) - amp


def gray(value: float, alpha: int = 255):
    level = clamp(value)
    return level, level, level, alpha


def prussian(t: float, alpha: int = 255):
    """Vertical ramp inside the Prussian family: 0 = deep, 1 = rim."""
    return (
        clamp(PRUSSIAN_DEEP[0] + (PRUSSIAN_RIM[0] - PRUSSIAN_DEEP[0]) * t),
        clamp(PRUSSIAN_DEEP[1] + (PRUSSIAN_RIM[1] - PRUSSIAN_DEEP[1]) * t),
        clamp(PRUSSIAN_DEEP[2] + (PRUSSIAN_RIM[2] - PRUSSIAN_DEEP[2]) * t),
        alpha,
    )


def menubar_pixel(x, y, w, h):
    """10.4 brushed black gunmetal: white rim, horizontal grain, blue hairline."""
    if y == 0:
        return gray(96)
    if y == 1:
        return gray(58)
    if y == h - 1:
        return prussian(0.62)
    if y == h - 2:
        return gray(6)
    t = y / max(1, h - 3)
    value = 32 - 24 * t + brushed(x, y, 4) + (2 if y % 6 == 0 else 0)
    return gray(value, 232)


def plate_pixel(x, y, w, h):
    """Prussian highlight plate for menubar items and menu hover."""
    if y == 0:
        return prussian(0.95)
    if y == h - 1:
        return prussian(0.08)
    t = y / max(1, h - 1)
    color = prussian(0.72 - 0.30 * t)
    return color[0], color[1], color[2], 255


def selected_pixel(x, y, w, h):
    """Selected-row plate: gunmetal body, Prussian edge and wash."""
    if x < 3:
        return prussian(0.85)
    if y == 0:
        return gray(38)
    if y == h - 1:
        return gray(4)
    t = y / max(1, h - 1)
    wash = 0.38 - 0.22 * t
    return (
        clamp(12 + (PRUSSIAN_LIT[0] - 12) * wash + brushed(x, y, 2)),
        clamp(16 + (PRUSSIAN_LIT[1] - 16) * wash + brushed(x, y, 2)),
        clamp(22 + (PRUSSIAN_LIT[2] - 22) * wash + brushed(x, y, 2)),
        255,
    )


def button_hover_pixel(x, y, w, h):
    """Raised gunmetal cap with a faint Prussian inner rim on hover."""
    edge = min(x, y, w - 1 - x, h - 1 - y)
    if y == 0:
        return gray(62)
    if y == h - 1:
        return gray(4)
    t = y / max(1, h - 1)
    value = 42 - 30 * t + brushed(x, y, 2)
    if edge == 1:
        return (
            clamp(value + (PRUSSIAN_RIM[0] - value) * 0.35),
            clamp(value + (PRUSSIAN_RIM[1] - value) * 0.35),
            clamp(value + (PRUSSIAN_RIM[2] - value) * 0.35),
            255,
        )
    return gray(value)


def button_active_pixel(x, y, w, h):
    """Pressed cap sinks into Prussian blue."""
    if y == 0:
        return prussian(0.05)
    if y == h - 1:
        return prussian(0.80)
    t = y / max(1, h - 1)
    color = prussian(0.10 + 0.55 * t)
    return color[0], color[1], color[2], 255


def preview_pixel(x, y, w, h):
    """Material board: menubar, toolbar, sidebar, list, controls."""
    if y < 26:
        return menubar_pixel(x, y, w, 26)
    if y < 64:
        if y == 26:
            return gray(30)
        value = 22 - 12 * ((y - 27) / 36) + brushed(x, y, 3)
        return gray(value)
    if x < 168:
        edge = 5 * (1 - x / 167)
        return gray(4 + edge + brushed(x, y, 1))
    if 74 <= y <= 88 and 176 <= x <= 388:
        return selected_pixel(x - 176, y - 74, 212, 15)
    return gray(2 + abs(brushed(x // 3, y // 2, 1)))


ASSETS = {
    "menubar.png": (512, 24, menubar_pixel),
    "plate-hover.png": (256, 24, plate_pixel),
    "selected-plate.png": (320, 24, selected_pixel),
    "button-hover.png": (320, 34, button_hover_pixel),
    "button-active.png": (320, 34, button_active_pixel),
    "preview.png": (640, 320, preview_pixel),
}


OVERRIDE_CSS = r'''/* Generated by tiger-gunmetal-gtk3-theme. Prussian accents over gunmetal. */

