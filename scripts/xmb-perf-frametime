#!/usr/bin/env python3
"""xmb-perf-frametime: presented-frame intervals via GLX_OML_sync_control.

Opens a 160x90 mapped window, swaps for DURATION seconds, records UST/MSC
deltas between actual presentations, and emits per-line microseconds plus a
SUMMARY= line with p50/p95/p99/stdev and a p1-p99 jitter spread in ms.
Degrades to FRAMETIME_UNAVAILABLE (exit 0) on any X/GLX failure so callers
never block. Authored and py_compiled in the sandbox, where X/GPU are absent.

Usage: xmb-perf-frametime [duration_seconds] [label]
"""
import ctypes, ctypes.util, os, statistics, sys, time
DUR = float(sys.argv[1]) if len(sys.argv) > 1 else 10.0
LABEL = sys.argv[2] if len(sys.argv) > 2 else "frametime"

def fail(r):
    print(f"FRAMETIME_UNAVAILABLE {r}"); return 0

def main():
    if not os.environ.get("DISPLAY"):
        return fail("no DISPLAY (run from the X session)")
    try:
        x11 = ctypes.CDLL(ctypes.util.find_library("X11"))
        gl = ctypes.CDLL(ctypes.util.find_library("GL"))
    except OSError as e:
        return fail(f"cannot load libX11/libGL: {e}")

    Dp = ctypes.c_void_p; Win = ctypes.c_ulong
    class VI(ctypes.Structure):
        _fields_ = [("visual", ctypes.c_void_p), ("visualid", ctypes.c_ulong),
            ("screen", ctypes.c_int), ("depth", ctypes.c_int), ("x_class", ctypes.c_int),
            ("red_mask", ctypes.c_ulong), ("green_mask", ctypes.c_ulong), ("blue_mask", ctypes.c_ulong),
            ("colormap_size", ctypes.c_int), ("bits_per_rgb", ctypes.c_int)]
    class SWA(ctypes.Structure):
        _fields_ = [("background_pixmap", ctypes.c_ulong), ("background_pixel", ctypes.c_ulong),
            ("border_pixmap", ctypes.c_ulong), ("border_pixel", ctypes.c_ulong),
            ("bit_gravity", ctypes.c_int), ("win_gravity", ctypes.c_int),
            ("backing_store", ctypes.c_int), ("backing_planes", ctypes.c_ulong), ("backing_pixel", ctypes.c_ulong),
            ("save_under", ctypes.c_int), ("event_mask", ctypes.c_long), ("do_not_propagate_mask", ctypes.c_long),
            ("override_redirect", ctypes.c_int), ("colormap", ctypes.c_ulong), ("cursor", ctypes.c_ulong)]

    for f, sig in [
        (x11.XOpenDisplay, ([ctypes.c_char_p], Dp)),
        (x11.XDefaultScreen, ([Dp], ctypes.c_int)),
        (x11.XRootWindow, ([Dp, ctypes.c_int], Win)),
        (x11.XCreateColormap, ([Dp, Win, ctypes.c_void_p, ctypes.c_int], ctypes.c_ulong)),
        (x11.XCreateWindow, ([Dp, Win, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint,
            ctypes.c_uint, ctypes.c_int, ctypes.c_uint, ctypes.c_void_p, ctypes.c_ulong,
            ctypes.POINTER(SWA)], Win)),
        (x11.XMapWindow, ([Dp, Win], None)), (x11.XFlush, ([Dp], None)),
        (x11.XCloseDisplay, ([Dp], None)), (x11.XStoreName, ([Dp, Win, ctypes.c_char_p], None)),
        (gl.glXChooseFBConfig, ([Dp, ctypes.c_int, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)],
            ctypes.POINTER(ctypes.c_void_p))),
        (gl.glXGetVisualFromFBConfig, ([Dp, ctypes.c_void_p], ctypes.POINTER(VI))),
        (gl.glXCreateNewContext, ([Dp, ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_int], ctypes.c_void_p)),
        (gl.glXMakeCurrent, ([Dp, Win, ctypes.c_void_p], ctypes.c_int)),
        (gl.glXSwapBuffers, ([Dp, Win], None)),
        (gl.glXGetProcAddress, ([ctypes.c_char_p], ctypes.c_void_p)),
        (gl.glXQueryExtension, ([Dp, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)], ctypes.c_int)),
    ]:
        f.argtypes, f.restype = sig

    dpy = x11.XOpenDisplay(None)
    if not dpy:
        return fail("XOpenDisplay returned NULL")
    try:
        scr = x11.XDefaultScreen(dpy); root = x11.XRootWindow(dpy, scr)
        ev = ctypes.c_int(); err = ctypes.c_int()
        if not gl.glXQueryExtension(dpy, ctypes.byref(ev), ctypes.byref(err)):
            return fail("no GLX on display")
        # RGBA double-buffered 24-depth. 1=GLX_USE_GL, 4=RGBA, 5=DOUBLEBUFFER,
        # 8/9/10=RED/GREEN/BLUE_SIZE, 12=DEPTH_SIZE, 0x8000=none.
        attrs = [1, 4, 5, 8, 8, 9, 8, 10, 8, 12, 24, 0x8000]
        arr = (ctypes.c_int * len(attrs))(*attrs); n = ctypes.c_int(0)
        cfgs = gl.glXChooseFBConfig(dpy, scr, arr, ctypes.byref(n))
        if not cfgs or n.value < 1:
            return fail("glXChooseFBConfig returned nothing")
        vi_p = gl.glXGetVisualFromFBConfig(dpy, cfgs[0])
        if not vi_p:
            return fail("glXGetVisualFromFBConfig NULL")
        vi = vi_p.contents
        cmap = x11.XCreateColormap(dpy, root, vi.visual, 0)
        swa = SWA(); swa.colormap = cmap; swa.event_mask = 0
        win = x11.XCreateWindow(dpy, root, 10, 10, 160, 90, 0, vi.depth, 1, vi.visual,
            0x8000, ctypes.byref(swa))  # 0x8000 = CWColormap
        if not win:
            return fail("XCreateWindow failed")
        x11.XStoreName(dpy, win, b"xmb-perf-frametime"); x11.XMapWindow(dpy, win); x11.XFlush(dpy)
        ctx = gl.glXCreateNewContext(dpy, cfgs[0], 0x8004, None, 1)  # GLX_RGBA_TYPE
        if not ctx or not gl.glXMakeCurrent(dpy, win, ctx):
            return fail("GL context creation/makecurrent failed")
        p = gl.glXGetProcAddress(b"glXGetSyncValuesOML")
        if not p:
            return fail("glXGetSyncValuesOML missing (GLX_OML_sync_control unsupported)")
        GetSync = ctypes.CFUNCTYPE(ctypes.c_int, Dp, Win,
            ctypes.POINTER(ctypes.c_int64), ctypes.POINTER(ctypes.c_int64),
            ctypes.POINTER(ctypes.c_int64))(p)
        msc_hz = 0.0
        pr = gl.glXGetProcAddress(b"glXGetMscRateOML")
        if pr:
            GetMsc = ctypes.CFUNCTYPE(ctypes.c_int, Dp, Win,
                ctypes.POINTER(ctypes.c_int32), ctypes.POINTER(ctypes.c_int32))(pr)
            num = ctypes.c_int32(0); den = ctypes.c_int32(0)
            if GetMsc(dpy, win, ctypes.byref(num), ctypes.byref(den)) and den.value:
                msc_hz = num.value / float(den.value)

        for _ in range(10):  # warm up the mapped window
            gl.glXSwapBuffers(dpy, win)
            u = ctypes.c_int64(); m = ctypes.c_int64(); s = ctypes.c_int64()
            GetSync(dpy, win, ctypes.byref(u), ctypes.byref(m), ctypes.byref(s)); time.sleep(.005)

        intervals, last_msc, last_ust = [], None, None
        deadline = time.monotonic() + DUR
        while time.monotonic() < deadline:
            gl.glXSwapBuffers(dpy, win)
            u = ctypes.c_int64(); m = ctypes.c_int64(); s = ctypes.c_int64()
            if not GetSync(dpy, win, ctypes.byref(u), ctypes.byref(m), ctypes.byref(s)):
                continue
            if last_msc is not None and m.value > last_msc:
                intervals.append(abs(u.value - last_ust))
            last_msc, last_ust = m.value, u.value
            time.sleep(.002)
    except Exception as e:  # sandbox has no X; defensive
        return fail(f"probe error: {e!r}")
    finally:
        try: gl.glXMakeCurrent(dpy, 0, None)
        except Exception: pass
        x11.XCloseDisplay(dpy)

    if len(intervals) < 20:
        return fail(f"only {len(intervals)} intervals")
    med = statistics.median(intervals)
    if med > 1_000_000: us, unit = [r / 1000.0 for r in intervals], "ns->us"
    elif med > 1000:    us, unit = [float(r) for r in intervals], "us"
    else:               us, unit = [float(r) for r in intervals], "raw"
    us.sort(); n = len(us)
    def pc(p): return us[min(n - 1, round((n - 1) * p))]
    mean, sd = statistics.fmean(us), statistics.pstdev(us)
    jit = (pc(.99) - pc(.01)) / 1000.0
    for v in us: print(f"{v:.1f}")
    print(f"SUMMARY label={LABEL} unit={unit} n={n} refresh_hz={msc_hz:.1f} "
        f"mean_us={mean:.1f} p50_us={pc(.5):.1f} p95_us={pc(.95):.1f} p99_us={pc(.99):.1f} "
        f"min_us={us[0]:.1f} max_us={us[-1]:.1f} stdev_us={sd:.1f} jitter_p1p99_ms={jit:.2f}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
