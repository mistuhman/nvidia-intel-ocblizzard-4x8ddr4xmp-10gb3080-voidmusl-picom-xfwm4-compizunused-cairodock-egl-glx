#!/usr/bin/env python3
"""Build, probe, apply and restore the Quake Gunmetal 3D GTK3 theme.

This tool composes a new per-user theme from Quake-Aqua-AMOLED (or an explicit
compatible Slickness-Reborn source). It never edits the source or /usr/share.
Generated assets use only Python's standard library.
"""

from __future__ import annotations

import argparse
from collections import Counter
import configparser
import hashlib
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import time
import zlib

THEME_NAME = "Quake-Gunmetal-3D"
DEFAULT_SOURCE_NAME = "Quake-Aqua-AMOLED"
SOURCE_WIDGETS_SHA = "bace908c47f868c044914b6a47be6d1469fb2e35a721249ab2355e364c737982"
SOURCE_APPLICATIONS_SHA = "2fe62f0f48a277ebfcdd4f8c4888ba156854f18f7a9c02fc345282d08cb181fa"
REQUIRED_ASSETS = {
    "darkelements/menubar.png": "a5fbab09ed09efe2cf5714e88f4538f093350b22e0f9ee1352890307fc6fe57d",
    "darkelements/toolbar.png": "02797b23cb5a768c416e922edd66a080fd3d3b2f5a7cd4858f84ef4f837f60ba",
    "darkelements/button-normal.png": "c2c775702dc2947041e80098ea31e83087c02c1259ca0fe259316ac7fc14a95d",
    "darkelements/button-hover.png": "95a0bf9a1d2dafc4a441eb48fe6a03d63f9a832f02297d7de0a999df731afb1c",
    "darkelements/entry.png": "3dd08ad4e58f118c148784a148a6b8eef504c7ed9f1a8f6fcd72e0a7b9e1fc0b",
    "darkelements/selected-bar.png": "902caab21c0ea5f3c86b096fb1d682781c42bf1e7b1106eeb649da3599227383",
    "darkelements/trough-scrollbar-vert.png": "1c39d3efffe98d5fa649a301bbbecbfcc9289dd2a53fdff9619d5f217f31429d",
}
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"


def fail(message: str) -> "NoReturn":
    raise SystemExit(f"ERROR: {message}")


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def aggregate_hash(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        digest.update(path.relative_to(root).as_posix().encode())
        digest.update(b"\0")
        digest.update(bytes.fromhex(sha256(path)))
    return digest.hexdigest()


def chunk(kind: bytes, payload: bytes) -> bytes:
    return (
        struct.pack(">I", len(payload))
        + kind
        + payload
        + struct.pack(">I", zlib.crc32(kind + payload) & 0xFFFFFFFF)
    )


def write_png(path: Path, width: int, height: int, pixel_function) -> None:
    raw = bytearray()
    for y in range(height):
        raw.append(0)
        for x in range(width):
            rgba = pixel_function(x, y, width, height)
            raw.extend(max(0, min(255, round(channel))) for channel in rgba)
    header = struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(
        PNG_SIGNATURE
        + chunk(b"IHDR", header)
        + chunk(b"IDAT", zlib.compress(bytes(raw), 9))
        + chunk(b"IEND", b"")
    )


def noise(x: int, y: int, amplitude: int = 3) -> int:
    value = (x * 1103515245 + y * 12345 + x * y * 97 + 0x5A17) & 0xFFFFFFFF
    return (value % (amplitude * 2 + 1)) - amplitude


def gray(value: float, alpha: int = 255):
    level = max(0, min(255, round(value)))
    return level, level, level, alpha


def vertical_material(
    x: int,
    y: int,
    width: int,
    height: int,
    *,
    top: int,
    middle: int,
    bottom: int,
    rim: int,
    alpha: int = 255,
    grain: int = 3,
):
    if y == 0:
        value = rim
    elif y == 1:
        value = max(top, rim - 12)
    elif y == height - 1:
        value = max(bottom, 28)
    elif y == height - 2:
        value = 2
    else:
        position = y / max(1, height - 1)
        if position < 0.42:
            value = top + (middle - top) * (position / 0.42)
        else:
            value = middle + (bottom - middle) * ((position - 0.42) / 0.58)
        # Horizontal brushed-metal grain and occasional hairline reflection.
        value += noise(x // 2, y, grain)
        if y % 7 == 0:
            value += 2
    return gray(value, alpha)


def menubar_pixel(x, y, w, h):
    return vertical_material(x, y, w, h, top=28, middle=9, bottom=4, rim=52, grain=2)


def toolbar_pixel(x, y, w, h):
    return vertical_material(x, y, w, h, top=24, middle=7, bottom=3, rim=46, grain=3)


def statusbar_pixel(x, y, w, h):
    return vertical_material(x, y, w, h, top=7, middle=3, bottom=13, rim=26, grain=2)


def headerbar_pixel(x, y, w, h):
    return vertical_material(x, y, w, h, top=30, middle=8, bottom=3, rim=54, grain=2)


def content_pixel(x, y, w, h):
    # Nearly black microtexture: visual material without noise behind text.
    value = noise(x // 3, y // 2, 2)
    if y % 32 == 0:
        value += 1
    return gray(max(0, value), 255)


def sidebar_pixel(x, y, w, h):
    edge = 6 * (1 - x / max(1, w - 1))
    value = 3 + edge + noise(x // 3, y // 2, 2)
    if x == w - 1:
        value = 20
    elif x == w - 2:
        value = 0
    return gray(value, 255)


def button_pixel_factory(state: str):
    def pixel(x, y, w, h):
        distance = min(x, y, w - 1 - x, h - 1 - y)
        if state == "hover":
            top, middle, bottom, rim = 39, 16, 6, 62
        elif state == "active":
            top, middle, bottom, rim = 6, 15, 28, 2
        elif state == "disabled":
            top, middle, bottom, rim = 16, 7, 4, 25
        else:
            top, middle, bottom, rim = 30, 11, 4, 48
        base = vertical_material(
            x, y, w, h, top=top, middle=middle, bottom=bottom, rim=rim, grain=2
        )
        value = base[0]
        if distance == 0:
            value = 2 if y > 0 else rim
        elif distance == 1 and y < h // 2:
            value += 8
        return gray(value, 220 if state == "disabled" else 255)

    return pixel


def entry_pixel(x, y, w, h):
    edge = min(x, y, w - 1 - x, h - 1 - y)
    if edge == 0:
        return gray(35)
    if edge == 1:
        return gray(2)
    if y < 5:
        return gray(1 + y)
    if y > h - 5:
        return gray(13 - (h - 1 - y) * 3)
    return gray(3 + noise(x // 4, y // 3, 1))


def selection_pixel(x, y, w, h):
    if x < 2:
        return (100, 12, 18, 255)
    return vertical_material(x, y, w, h, top=32, middle=16, bottom=6, rim=48, grain=2)


def trough_v_pixel(x, y, w, h):
    if x in (0, w - 1):
        return gray(20)
    if x in (1, w - 2):
        return gray(1)
    return gray(4 + noise(x, y // 4, 2))


def trough_h_pixel(x, y, w, h):
    if y in (0, h - 1):
        return gray(20)
    if y in (1, h - 2):
        return gray(1)
    return gray(4 + noise(x // 4, y, 2))


def thumb_v_pixel(x, y, w, h):
    edge = min(x, w - 1 - x)
    if edge == 0:
        return gray(2)
    if edge == 1:
        return gray(40)
    value = 17 + (w // 2 - abs(x - w // 2)) * 2 + noise(x, y // 3, 2)
    if y in (0, h - 1):
        value = 46
    return gray(value)


def thumb_h_pixel(x, y, w, h):
    edge = min(y, h - 1 - y)
    if edge == 0:
        return gray(2)
    if edge == 1:
        return gray(40)
    value = 17 + (h // 2 - abs(y - h // 2)) * 2 + noise(x // 3, y, 2)
    if x in (0, w - 1):
        value = 46
    return gray(value)


def preview_pixel(x, y, w, h):
    # Self-contained material board used in Appearance/theme previews.
    if y < 34:
        return menubar_pixel(x, y, w, 34)
    if y < 82:
        return toolbar_pixel(x, y - 34, w, 48)
    if x < 180:
        return sidebar_pixel(x, y - 82, 180, h - 82)
    return content_pixel(x - 180, y - 82, w - 180, h - 82)


ASSETS = {
    "menubar.png": (512, 24, menubar_pixel),
    "toolbar.png": (512, 38, toolbar_pixel),
    "headerbar.png": (512, 42, headerbar_pixel),
    "statusbar.png": (512, 26, statusbar_pixel),
    "content-well.png": (256, 256, content_pixel),
    "sidebar-well.png": (128, 256, sidebar_pixel),
    "button-normal.png": (320, 34, button_pixel_factory("normal")),
    "button-hover.png": (320, 34, button_pixel_factory("hover")),
    "button-active.png": (320, 34, button_pixel_factory("active")),
    "button-disabled.png": (320, 34, button_pixel_factory("disabled")),
    "entry-well.png": (320, 34, entry_pixel),
    "selected-plate.png": (320, 28, selection_pixel),
    "scroll-trough-v.png": (16, 256, trough_v_pixel),
    "scroll-trough-h.png": (256, 16, trough_h_pixel),
    "scroll-thumb-v.png": (16, 64, thumb_v_pixel),
    "scroll-thumb-h.png": (64, 16, thumb_h_pixel),
    "preview.png": (640, 360, preview_pixel),
}


