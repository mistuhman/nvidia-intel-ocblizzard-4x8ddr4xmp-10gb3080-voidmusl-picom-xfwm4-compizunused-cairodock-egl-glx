def verify_source(source: Path) -> None:
    gtk3 = source / "gtk-3.0"
    required = [source / "index.theme", gtk3 / "gtk.css", gtk3 / "gtk-widgets.css"]
    for path in required:
        if not path.is_file():
            fail(f"source is missing {path}")
    if sha256(gtk3 / "gtk-widgets.css") != SOURCE_WIDGETS_SHA:
        fail("source gtk-widgets.css does not match the verified Slickness tree")
    if sha256(gtk3 / "applications.css") != SOURCE_APPLICATIONS_SHA:
        fail("source applications.css does not match the verified Slickness tree")
    for relative, expected in REQUIRED_ASSETS.items():
        path = gtk3 / relative
        if not path.is_file() or sha256(path) != expected:
            fail(f"source asset mismatch: {path}")


def update_index(path: Path) -> None:
    parser = configparser.ConfigParser(interpolation=None)
    parser.optionxform = str
    parser.read(path)
    if "Desktop Entry" not in parser or "X-GNOME-Metatheme" not in parser:
        fail(f"unsupported index.theme: {path}")
    parser["Desktop Entry"]["Name"] = THEME_NAME
    parser["Desktop Entry"]["Comment"] = (
        "AMOLED Quake gunmetal GTK3 with dimensional generated artwork"
    )
    parser["X-GNOME-Metatheme"]["GtkTheme"] = THEME_NAME
    if "GtkColorScheme" in parser["X-GNOME-Metatheme"]:
        scheme = parser["X-GNOME-Metatheme"]["GtkColorScheme"]
        wanted = {
            "bg_color": "#000000",
            "base_color": "#000000",
            "selected_bg_color": "#242424",
            "selected_fg_color": "#ffffff",
            "tooltip_bg_color": "#050505",
            "tooltip_fg_color": "#e0e0e0",
        }
        fields = []
        seen = set()
        for field in scheme.split(","):
            key, separator, value = field.partition(":")
            normalized = key.strip()
            if separator and normalized in wanted:
                fields.append(f"{normalized}:{wanted[normalized]}")
                seen.add(normalized)
            else:
                fields.append(field)
        missing = set(wanted) - seen
        if missing:
            fail(f"index.theme color scheme lacks keys: {sorted(missing)}")
        parser["X-GNOME-Metatheme"]["GtkColorScheme"] = ",".join(fields)
    with path.open("w") as handle:
        parser.write(handle, space_around_delimiters=False)


def update_gtk_css(path: Path) -> None:
    text = path.read_text()
    text, bg_count = re.subn(
        r"(@define-color\s+theme_bg_color\s+)#[0-9a-fA-F]{6}(\s*;)",
        r"\g<1>#000000\2",
        text,
    )
    text, base_count = re.subn(
        r"(@define-color\s+theme_base_color\s+)#[0-9a-fA-F]{6}(\s*;)",
        r"\g<1>#000000\2",
        text,
    )
    if bg_count != 1 or base_count != 1:
        fail(f"unexpected named palette counts bg={bg_count}, base={base_count}")
    import_line = '@import url("gunmetal-3d.css");'
    if import_line in text:
        fail("source already imports gunmetal-3d.css")
    path.write_text(text.rstrip() + "\n" + import_line + "\n")


def build(source: Path, output: Path, force: bool) -> None:
    verify_source(source)
    if output.exists():
        if not force:
            fail(f"output exists (use --force): {output}")
        backup = output.with_name(f"{output.name}.pre-rebuild.{int(time.time())}")
        output.rename(backup)
        print(f"Preserved previous build: {backup}")

    temporary = output.with_name(f".{output.name}.tmp.{os.getpid()}")
    if temporary.exists():
        shutil.rmtree(temporary)
    shutil.copytree(source, temporary, symlinks=True)
    try:
        update_index(temporary / "index.theme")
        update_gtk_css(temporary / "gtk-3.0/gtk.css")
        (temporary / "gtk-3.0/gunmetal-3d.css").write_text(OVERRIDE_CSS)
        asset_root = temporary / "gtk-3.0/gunmetal3d"
        for name, (width, height, function) in ASSETS.items():
            path = asset_root / name
            write_png(path, width, height, function)
            print(f"Generated {name}: {width}x{height}")
        (temporary / "GUNMETAL-3D-BUILD-RECEIPT.txt").write_text(
            f"Theme: {THEME_NAME}\n"
            f"Source aggregate: {aggregate_hash(source)}\n"
            f"Source widgets CSS: {SOURCE_WIDGETS_SHA}\n"
            f"Source applications CSS: {SOURCE_APPLICATIONS_SHA}\n"
            "Material: brushed black gunmetal, reflected raised shelves, recessed wells\n"
            "Palette: black, charcoal, silver, white, controlled red selection edge\n"
            f"Rollback theme: {source.name}\n"
        )
        temporary.rename(output)
    except BaseException:
        if temporary.exists():
            shutil.rmtree(temporary)
        raise

    print(f"Built: {output}")
    print(f"Files: {sum(1 for p in output.rglob('*') if p.is_file())}")
    print(f"Aggregate: {aggregate_hash(output)}")
    print(f"Override CSS: {sha256(output / 'gtk-3.0/gunmetal-3d.css')}")
    print(f"Preview: {output / 'gtk-3.0/gunmetal3d/preview.png'}")


def get_xsetting() -> str:
    result = subprocess.run(
        ["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName"],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        fail(f"cannot read /Net/ThemeName: {result.stderr.strip()}")
    return result.stdout.strip()


def set_xsetting(name: str) -> None:
    subprocess.run(
        [
            "xfconf-query",
            "-c",
            "xsettings",
            "-p",
            "/Net/ThemeName",
            "-s",
            name,
        ],
        check=True,
    )


PROBE_PROGRAM = r'''
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk
w = Gtk.Window()
b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
menu = Gtk.MenuBar()
menu.append(Gtk.MenuItem(label="File"))
b.pack_start(menu, False, False, 0)
toolbar = Gtk.Toolbar()
toolbar.insert(Gtk.ToolButton.new(None, "Tool"), -1)
b.pack_start(toolbar, False, False, 0)
b.pack_start(Gtk.Entry(text="Inset entry"), False, False, 0)
b.pack_start(Gtk.Button(label="Raised button"), False, False, 0)
w.add(b)
w.realize()
while Gtk.events_pending(): Gtk.main_iteration()
print("GTK3 realization PASS")
w.destroy()
'''


def probe(theme: str, baseline: str) -> None:
    def run(name: str):
        environment = os.environ.copy()
        environment["GTK_THEME"] = name
        result = subprocess.run(
            [sys.executable, "-c", PROBE_PROGRAM],
            text=True,
            capture_output=True,
            env=environment,
            check=False,
        )
        warnings = []
        for line in result.stderr.splitlines():
            marker = "Theme parsing error"
            if marker in line:
                # PID/timestamp prefixes differ between the two subprocesses;
                # compare only the stable parser location/message payload.
                warnings.append(marker + line.split(marker, 1)[1].strip())
        print(f"{name}: exit={result.returncode}, parser_warnings={len(warnings)}")
        for line in warnings:
            print(f"  {line}")
        if result.stdout.strip():
            print(f"  {result.stdout.strip()}")
        return result.returncode, Counter(warnings)

    baseline_status, baseline_warnings = run(baseline)
    candidate_status, candidate_warnings = run(theme)
    new_warnings = candidate_warnings - baseline_warnings
    if baseline_status or candidate_status:
        fail("GTK3 realization process failed")
    if new_warnings:
        for line, count in new_warnings.items():
            print(f"NEW WARNING x{count}: {line}")
        fail("candidate introduced new GTK parser warnings")
    print("PROBE PASS: candidate introduces zero new parser warnings")


def apply(theme: str, state_file: Path) -> None:
    current = get_xsetting()
    state_file.parent.mkdir(parents=True, exist_ok=True)
    if current == theme and state_file.is_file():
        previous = state_file.read_text().strip()
        print(f"Preserved existing rollback while rebuilding active theme: {previous}")
    else:
        state_file.write_text(current + "\n")
        previous = current
        print(f"Previous GTK theme recorded: {previous}")
    set_xsetting(theme)
    print(f"Active GTK theme: {get_xsetting()}")
    print(f"Rollback target: {previous}")
    print(f"Rollback: {Path(__file__).resolve()} restore")


def restore(state_file: Path, fallback: str) -> None:
    target = state_file.read_text().strip() if state_file.is_file() else fallback
    set_xsetting(target)
    print(f"Restored GTK theme: {get_xsetting()}")


def status(output: Path, state_file: Path) -> None:
    print(f"active GTK: {get_xsetting()}")
    print(f"theme path: {output}")
    if output.is_dir():
        print(f"aggregate: {aggregate_hash(output)}")
        print(f"override CSS: {sha256(output / 'gtk-3.0/gunmetal-3d.css')}")
    else:
        print("theme: MISSING")
    if state_file.is_file():
        print(f"recorded rollback: {state_file.read_text().strip()}")
    for process in ("compiz", "emerald", "picom"):
        result = subprocess.run(
            ["pgrep", "-ax", process], text=True, capture_output=True, check=False
        )
        print(f"{process}: {result.stdout.strip() or '(absent)'}")


def main() -> None:
    home = Path.home()
    default_source = home / ".themes" / DEFAULT_SOURCE_NAME
    default_output = home / ".themes" / THEME_NAME
    default_state = home / ".local/state/gunmetal-gtk3/previous-theme"

    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    build_parser = subparsers.add_parser("build")
    build_parser.add_argument("--source", type=Path, default=default_source)
    build_parser.add_argument("--output", type=Path, default=default_output)
    build_parser.add_argument("--force", action="store_true")

    probe_parser = subparsers.add_parser("probe")
    probe_parser.add_argument("--theme", default=THEME_NAME)
    probe_parser.add_argument("--baseline", default=DEFAULT_SOURCE_NAME)

    apply_parser = subparsers.add_parser("apply")
    apply_parser.add_argument("--theme", default=THEME_NAME)
    apply_parser.add_argument("--state-file", type=Path, default=default_state)

    restore_parser = subparsers.add_parser("restore")
    restore_parser.add_argument("--state-file", type=Path, default=default_state)
    restore_parser.add_argument("--fallback", default=DEFAULT_SOURCE_NAME)

    status_parser = subparsers.add_parser("status")
    status_parser.add_argument("--output", type=Path, default=default_output)
    status_parser.add_argument("--state-file", type=Path, default=default_state)

    args = parser.parse_args()
    if args.command == "build":
        build(args.source.expanduser(), args.output.expanduser(), args.force)
    elif args.command == "probe":
        probe(args.theme, args.baseline)
    elif args.command == "apply":
        apply(args.theme, args.state_file.expanduser())
    elif args.command == "restore":
        restore(args.state_file.expanduser(), args.fallback)
    else:
        status(args.output.expanduser(), args.state_file.expanduser())


if __name__ == "__main__":
    main()
