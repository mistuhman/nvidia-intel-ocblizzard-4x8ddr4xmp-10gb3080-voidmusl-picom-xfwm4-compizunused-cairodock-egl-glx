id -u
# lion-clean-inventory.block - ROOT shell on the Mac Pro 3,1 (sudo -s, then paste). READ-ONLY. Changes nothing.
# Wave: 2026-09-17 clear + harden the Lion SSD. Policy source: tools/lion-clean-plan.ts
# HARD RULE (operator "without wiping drives"): no eraseDisk, no eraseVolume, no partitionDisk,
# no asr, no rm of an app. Removal is a reversible MOVE to a quarantine folder on the same volume.
# Gate: paste the FULL output back. The sweep list is computed from THIS receipt, never from memory.
cat > /tmp/lion-clean-inventory.sh <<'INVSH'
#!/bin/sh
# read-only inventory: volume, keep-targets, app classification, keep-dirs, space
echo "== VOLUME (boot volume is never a sweep or erase target)"
mount | grep ' on / '
df -h /
echo
echo "== DISK MAP (read-only; proves nothing is being erased)"
diskutil list
echo
echo "== KEEP TARGETS - each must read PRESENT or ABSENT, never be touched"
for n in "CandyBar" "Flavours" "AirPort Utility" "ArcticFox" "iTunes" "Audacity" "AU Lab" "GarageBand" "Logic" "Utilities"; do
  F=""
  [ -e "/Applications/$n.app" ] && F="/Applications/$n.app"
  [ -e "/Applications/Utilities/$n.app" ] && F="/Applications/Utilities/$n.app"
  [ -d "/Applications/$n" ] && F="/Applications/$n"
  if [ -n "$F" ]; then echo "PRESENT keep: $F"; else echo "ABSENT  keep: $n"; fi
done
echo
echo "== APP INVENTORY: class | size | bundle id | path"
echo "== APPLE = protected by rule (10.7 store catalog is dead, reinstall is the only recovery)"
echo "== KEEP  = operator allowlist. CANDIDATE = third-party, proposed for quarantine."
for a in /Applications/*.app /Applications/Utilities/*.app; do
  [ -e "$a" ] || continue
  B=$(defaults read "$a/Contents/Info" CFBundleIdentifier 2>/dev/null)
  [ -z "$B" ] && B="(no-bundle-id)"
  N=$(basename "$a" .app)
  SZ=$(du -hs "$a" 2>/dev/null | awk '{print $1}')
  CLASS="CANDIDATE"
  case "$B" in com.apple.*) CLASS="APPLE";; esac
  case "$N" in "AU Lab"*|"AirPort"*|"Arctic"*|"Audacity"*|"CandyBar"*|"Flavours"*|"GarageBand"*|"Logic"*|"Utilities"|"iTunes"*) CLASS="KEEP";; esac
  echo "$CLASS | $SZ | $B | $a"
done
echo
echo "== CANDIDATE TOTAL (what a sweep would quarantine, and how much it frees)"
for a in /Applications/*.app /Applications/Utilities/*.app; do
  [ -e "$a" ] || continue
  B=$(defaults read "$a/Contents/Info" CFBundleIdentifier 2>/dev/null)
  N=$(basename "$a" .app)
  case "$B" in com.apple.*) continue;; esac
  case "$N" in "AU Lab"*|"AirPort"*|"Arctic"*|"Audacity"*|"CandyBar"*|"Flavours"*|"GarageBand"*|"Logic"*|"Utilities"|"iTunes"*) continue;; esac
  du -hs "$a" 2>/dev/null
done
echo
echo "== KEEP DIRS - themes, icons, downloads (must be byte-identical after the wave)"
for u in $(ls /Users | grep -v Shared); do
  echo "-- user $u"
  du -hs "/Users/$u/Downloads" 2>/dev/null
  du -hs "/Users/$u/Library/Application Support/CandyBar" 2>/dev/null
  du -hs "/Users/$u/Library/Application Support/Flavours" 2>/dev/null
  ls "/Users/$u/Library/Preferences/com.panic.CandyBar3.plist" 2>/dev/null
  du -hs "/Users/$u/Pictures" 2>/dev/null
  find "/Users/$u" -maxdepth 3 -iname "*.iconset" -o -maxdepth 3 -iname "*.icontainer" -o -maxdepth 3 -iname "*.flavour" 2>/dev/null | head -20
done
du -hs "/Library/Desktop Pictures" 2>/dev/null
echo
echo "== RECLAIMABLE JUNK (caches, logs, trash - the clean phase)"
du -hs /Library/Caches 2>/dev/null
du -hs /private/var/log 2>/dev/null
for u in $(ls /Users | grep -v Shared); do
  du -hs "/Users/$u/Library/Caches" 2>/dev/null
  du -hs "/Users/$u/.Trash" 2>/dev/null
done
echo
echo "== FILESYSTEM HEALTH (live verify; journaled HFS+ only, read-only)"
diskutil verifyVolume / 2>&1 | tail -20
echo "== INVENTORY COMPLETE - NOTHING WAS CHANGED"
INVSH
sh /tmp/lion-clean-inventory.sh
date
