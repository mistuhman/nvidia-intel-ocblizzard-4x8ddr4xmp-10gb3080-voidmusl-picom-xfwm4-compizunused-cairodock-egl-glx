id -u
# cpu-park-bench.block v4 - ROOT shell (sudo -i FIRST).
# bench-oc: P-cores all-core 5.0 GHz (1-2C 5.1) + E-core cluster 4.0 GHz (0x1ae 40x)
# + PL1 241 W + powersave/performance EPP + cpuidle menu.
# PREREQ (BIOS F10): XMP DDR4-3733 Profile 1 (receipted 3733 x4 on 2026-08-28 run 19080771:
# SC 2759 = 101.6 percent PASSED, MC 14549 = 99.86 percent, 166 short of 14715).
# NEVER the 4000 MT/s 1.45V custom profile. NEVER 1.50V+ (1.55V killed a boot already).
# Gate: 0x1ad readback 3232323232323333; 0x1ae readback 2828282828282828; freq-proof E Bzy >= 3900;
# Geekbench SC >= 2743 AND MC >= 14715 in the SAME run (101 percent shared).
# Receipted dead knobs: 51x executes as 5000 (fused 50x); PL1 241W does not move the ~146W wall;
# cpu_capacity sysfs read-only (Permission denied as root); sched_itmt file absent.
# Rollback: sh /home/sd/oc-lab/scripts/cpu-park-ctrl restore (0x1ad + 0x1ae stock) or any reboot.
df -h /
dmidecode -t memory | grep -E 'Configured Memory Speed' | head -n 8
git -C /home/sd/oc-lab pull
sh /home/sd/oc-lab/scripts/cpu-park-ctrl bench-oc
sh /home/sd/oc-lab/scripts/cpu-park-ctrl probe-itmt
sh /home/sd/oc-lab/scripts/cpu-park-ctrl freq-proof
sh /home/sd/oc-lab/scripts/cpu-park-ctrl bench-geekbench
sh /home/sd/oc-lab/scripts/cpu-park-ctrl restore
sh /home/sd/oc-lab/scripts/cpu-park-ctrl status
date
