id -u
# cpu-park-bench.block - ROOT shell (sudo -i).
# Run official Geekbench 6 CPU benchmark under turbostat meter with asym-game profile.
# Why: P-cores at 5.0 GHz max boost, E-cores resting at 2.4 GHz (power EPP), all 20 threads online.
# Gate: Geekbench 6 uploads result URL; turbostat summarizes peak watts/clocks/temp; restore returns daily state.
# Rollback: sh /home/sd/oc-lab/scripts/cpu-park-ctrl restore
df -h /
git -C /home/sd/oc-lab pull
ls -l /home/sd/oc-lab/scripts/cpu-park-ctrl
sh /home/sd/oc-lab/scripts/cpu-park-ctrl asym-game
sh /home/sd/oc-lab/scripts/cpu-park-ctrl status
sh /home/sd/oc-lab/scripts/cpu-park-ctrl bench-geekbench
sh /home/sd/oc-lab/scripts/cpu-park-ctrl restore
sh /home/sd/oc-lab/scripts/cpu-park-ctrl status
date
