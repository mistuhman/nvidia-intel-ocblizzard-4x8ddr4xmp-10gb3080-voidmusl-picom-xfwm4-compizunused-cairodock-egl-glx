id -u
# cpu-park-bench.block - ROOT shell (sudo -i).
# bench-oc: All-Core 5.0 GHz (3-8C=50x) + 5.1 GHz Priority (1-2C=51x) + E-core 3.8 GHz +
# PL1 241 W + powersave/performance EPP + cpuidle menu + E-core capacity 778.
# Why: 0x2f2f303031313333 clamped Bzy_MHz to 4700 MHz because active desktop threads woke
#      up all 8 P-cores. 0x3232323232323333 enforces 5.0 GHz across all 8 P-cores continuously.
# Gate: 0x1ad readback 3232323232323333; freq-proof Bzy_MHz >= 5000 (5100 on 1C);
#       Geekbench URL; restore returns daily state.
# Rollback: sh /home/sd/oc-lab/scripts/cpu-park-ctrl restore
df -h /
git -C /home/sd/oc-lab fetch origin
git -C /home/sd/oc-lab checkout arena/01a04647-nvidia-intel-ocblizzard-4x8ddr
git -C /home/sd/oc-lab pull
ls -l /home/sd/oc-lab/scripts/cpu-park-ctrl
sh /home/sd/oc-lab/scripts/cpu-park-ctrl bench-oc
sh /home/sd/oc-lab/scripts/cpu-park-ctrl status
sh /home/sd/oc-lab/scripts/cpu-park-ctrl probe-itmt
sh /home/sd/oc-lab/scripts/cpu-park-ctrl freq-proof
sh /home/sd/oc-lab/scripts/cpu-park-ctrl bench-geekbench
sh /home/sd/oc-lab/scripts/cpu-park-ctrl restore
sh /home/sd/oc-lab/scripts/cpu-park-ctrl status
date
