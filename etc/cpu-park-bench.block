id -u
# cpu-park-persist v11 - ROOT shell (sudo -i FIRST).
# USER SHELL FIRST (separate paste): git -C /home/sd/oc-lab pull
# v10 SIGSTOP-compiz CRASHED the PC (hard freeze): SIGSTOP-on-compositor class is
# CLOSED FOREVER - this block replaces v10 and contains no compositor signals.
# Operator directive: make the 19081392 profile permanent (SC 2770 = 102.0%, MC 14506;
# peaks 149.6 W / 74 C). Mechanism = runit service /etc/sv/cpu-park-oc -> /var/service:
# applies bench-oc (P 50x + 51x 1-2C, E 3.8 stock, PL1 241 W, menu idle) + IRQ pins at
# every boot; own script copy + sha; log /var/log/cpu-park-oc.log.
# Inverse: sh cpu-park-ctrl persist-remove (next boot stock); live revert: restore.
sh /home/sd/oc-lab/scripts/cpu-park-ctrl persist-install
sh /home/sd/oc-lab/scripts/cpu-park-ctrl bench-oc
sh /home/sd/oc-lab/scripts/cpu-park-ctrl irq-pin-bench
sv status cpu-park-oc
ls -l /etc/sv/cpu-park-oc
sh /home/sd/oc-lab/scripts/cpu-park-ctrl status
date
