id -u
# cpu-park-bench v7 IRQ-off-P wave - ROOT shell (sudo -i FIRST).
# Receipt: MC fell AGAIN at identical config (14549 -> 14433 -> 14316 -> 14265) = external
# load, not knobs. /proc/interrupts: NIC 705k IRQs on P-CORE CPU2 (pin drifted), GPU 1.08M
# on CPU4. Disk used grew 123G -> 156G during today's session (something big is running).
# This wave: pin nvidia/nvkm IRQs to CPU18 + NIC to CPU19 (E-cores, off the bench), then
# inventory load (uptime, top ps, zpool scrub check, free) then bench the SAME profile.
# Gates (operator 2026-08-28): SC >= 2770 (102 percent) AND MC >= 14715 (101 percent) same run.
# Rollback: cpu-park-ctrl irq-restore + cpu-park-ctrl restore; reboot clears everything.
df -h /
uptime
ps -eo pcpu,rss,pid,comm --sort=-pcpu | sed -n '1,10p'
zpool status nvme | sed -n '1,6p'
